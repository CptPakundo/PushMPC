// PushMPC capture mode: a planar YUV 4:2:0 picture (the engine's output in its buffer, or an upload; 8-bit samples, or
// little-endian 16-bit ones holding `bits` bits) -> the window's swapchain texel, packed by hand into a 32-bit storage
// image (r32ui) that is then copied raw into the swapchain image (the same texel size, any 32-bit format):
//   out 0  SDR: R'G'B'A 8:8:8:8 (swapRB: B, G, R for a BGRA swapchain); PQ content is brought down to SDR (SDR white =
//          sdrWhite nits, a soft knee above it)
//   out 1  HDR10: A2B10G10R10 in BT.2020 PQ (VK_COLOR_SPACE_HDR10_ST2084_EXT); SDR content at SDR white = sdrWhite
//          nits (BT.1886 decode, BT.709 -> BT.2020 primaries, PQ encode); PQ content passes through
// Bilinear scaling to the window with the aspect ratio kept (black bars outside). Content: pq = 0 BT.709 limited range,
// 1 BT.2020 NCL limited range PQ.
#version 450
layout(local_size_x = 16, local_size_y = 8) in;
layout(std430, binding = 0) readonly buffer Yuv { uint words[]; };
layout(r32ui, binding = 1) writeonly uniform uimage2D dst;
layout(push_constant) uniform P {
    int w, h, cw, ch;
    int offY, offU, offV;    // bytes
    int pitchY, pitchC;      // bytes
    int dw, dh;
    int vx, vy, vw, vh;
    int swapRB;
    int bits;                // 8, or 9..16 (two bytes a sample)
    int pq;                  // content: 0 BT.709 SDR, 1 BT.2020 PQ
    int outMode;             // 0 SDR, 1 HDR10
    float sdrWhite;          // nits of SDR white
} pc;

float Byte(int o) { return float((words[o >> 2] >> uint(8 * (o & 3))) & 255u); }
// one sample as an 8-bit code value (fractional for deeper pictures)
float Samp(int off, int pitch, int x, int y)
{
    if (pc.bits <= 8) return Byte(off + y * pitch + x);
    int o = off + y * pitch + 2 * x;
    return (Byte(o) + 256.0 * Byte(o + 1)) / float(1 << (pc.bits - 8));
}

float Bilinear(int off, int pitch, int pw, int ph, vec2 p)
{
    p -= 0.5;
    vec2 f = fract(p);
    ivec2 i = ivec2(floor(p));
    ivec2 lo = clamp(i, ivec2(0), ivec2(pw - 1, ph - 1)), hi = clamp(i + 1, ivec2(0), ivec2(pw - 1, ph - 1));
    float a = Samp(off, pitch, lo.x, lo.y), b = Samp(off, pitch, hi.x, lo.y);
    float c = Samp(off, pitch, lo.x, hi.y), d = Samp(off, pitch, hi.x, hi.y);
    return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}

const float m1 = 0.1593017578125, m2 = 78.84375, c1 = 0.8359375, c2 = 18.8515625, c3 = 18.6875;
vec3 PqToLinear(vec3 e)   // 1.0 = 10000 nits
{
    vec3 p = pow(clamp(e, 0.0, 1.0), vec3(1.0 / m2));
    return pow(max(p - c1, 0.0) / (c2 - c3 * p), vec3(1.0 / m1));
}
vec3 LinearToPq(vec3 l)
{
    vec3 p = pow(clamp(l, 0.0, 1.0), vec3(m1));
    return pow((c1 + c2 * p) / (1.0 + c3 * p), vec3(m2));
}
// columns (GLSL is column-major)
const mat3 k709to2020 = mat3(0.6274, 0.0691, 0.0164, 0.3293, 0.9195, 0.0880, 0.0433, 0.0114, 0.8956);
const mat3 k2020to709 = mat3(1.6605, -0.1246, -0.0182, -0.5876, 1.1329, -0.1006, -0.0728, -0.0083, 1.1187);

void main()
{
    ivec2 g = ivec2(gl_GlobalInvocationID.xy);
    if (g.x >= pc.dw || g.y >= pc.dh) return;
    vec3 rgb = vec3(0.0);   // the content's R'G'B' (BT.709 gamma, or BT.2020 PQ); bars stay black
    if (g.x >= pc.vx && g.y >= pc.vy && g.x < pc.vx + pc.vw && g.y < pc.vy + pc.vh) {
        vec2 uv = (vec2(g - ivec2(pc.vx, pc.vy)) + 0.5) / vec2(pc.vw, pc.vh);
        float Y = Bilinear(pc.offY, pc.pitchY, pc.w, pc.h, uv * vec2(pc.w, pc.h));
        float U = Bilinear(pc.offU, pc.pitchC, pc.cw, pc.ch, uv * vec2(pc.cw, pc.ch));
        float V = Bilinear(pc.offV, pc.pitchC, pc.cw, pc.ch, uv * vec2(pc.cw, pc.ch));
        float y = (Y - 16.0) / 219.0, u = (U - 128.0) / 224.0, v = (V - 128.0) / 224.0;
        vec3 k = pc.pq != 0 ? vec3(0.2627, 0.6780, 0.0593) : vec3(0.2126, 0.7152, 0.0722);
        float r = y + 2.0 * (1.0 - k.x) * v, b = y + 2.0 * (1.0 - k.z) * u;
        float gg = (y - k.x * r - k.z * b) / k.y;
        rgb = clamp(vec3(r, gg, b), 0.0, 1.0);
    }
    uint texel;
    if (pc.outMode == 1) {
        vec3 e = pc.pq != 0 ? rgb : LinearToPq(k709to2020 * pow(rgb, vec3(2.4)) * (pc.sdrWhite / 10000.0));
        uvec3 q = uvec3(clamp(e, 0.0, 1.0) * 1023.0 + 0.5);
        texel = q.r | (q.g << 10) | (q.b << 20) | (3u << 30);
    } else {
        vec3 s = rgb;
        if (pc.pq != 0) {
            vec3 l = max(k2020to709 * PqToLinear(rgb) * (10000.0 / pc.sdrWhite), 0.0);
            l = l / (1.0 + max(l - 0.8, 0.0));
            s = pow(clamp(l, 0.0, 1.0), vec3(1.0 / 2.4));
        }
        uvec3 q = uvec3(clamp(s, 0.0, 1.0) * 255.0 + 0.5);
        if (pc.swapRB != 0) q = q.bgr;
        texel = q.r | (q.g << 8) | (q.b << 16) | (255u << 24);
    }
    imageStore(dst, g, uvec4(texel, 0u, 0u, 0u));
}
