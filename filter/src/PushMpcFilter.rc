#include <windows.h>
#include "resource.h"
#include "version.h"

// Plain Win32 controls only (no owner draw, no own colours): MPC-HC hosts COM property pages in its
// CMPCThemeComPropertyPage, which subclasses standard controls for its dark theme, as it does for LAV's pages.
IDD_PUSHMPC_PAGE DIALOGEX 0, 0, 300, 426
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    AUTOCHECKBOX    "Enable PushMPC", IDC_PM_ENABLE, 7, 7, 200, 10
    LTEXT           "Smoother", -1, 7, 26, 52, 8
    COMBOBOX        IDC_PM_SMOOTH, 62, 24, 74, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_PM_SMOOTH_NOW, 142, 26, 151, 8, SS_ENDELLIPSIS
    LTEXT           "Sharper", -1, 7, 42, 52, 8
    COMBOBOX        IDC_PM_SHARP, 62, 40, 74, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_PM_SHARP_NOW, 142, 42, 151, 8, SS_ENDELLIPSIS
    LTEXT           "Clean up", -1, 7, 58, 52, 8
    COMBOBOX        IDC_PM_CLEAN, 62, 56, 74, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_PM_CLEAN_NOW, 142, 58, 151, 8, SS_ENDELLIPSIS
    LTEXT           "SDR to HDR", -1, 7, 74, 52, 8
    COMBOBOX        IDC_PM_HDR, 62, 72, 74, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_PM_HDR_NOW, 142, 74, 151, 8, SS_ENDELLIPSIS
    LTEXT           "HDR boost", -1, 7, 90, 52, 8
    COMBOBOX        IDC_PM_HDRBOOST, 62, 88, 74, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Status", -1, 7, 108, 100, 8
    EDITTEXT        IDC_PM_STATUS, 7, 118, 286, 64, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
    PUSHBUTTON      "Show advanced settings", IDC_PM_ADVANCED, 7, 188, 110, 14
    GROUPBOX        "Advanced", IDC_PM_ADV_GROUP, 7, 206, 286, 216
    LTEXT           "FG quality", IDC_PM_FGQ_LBL, 15, 220, 62, 8
    COMBOBOX        IDC_PM_FGQ, 78, 218, 64, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Upscale style", IDC_PM_STYLE_LBL, 152, 220, 62, 8
    COMBOBOX        IDC_PM_STYLE, 216, 218, 70, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Upscale to", IDC_PM_TARGET_LBL, 15, 236, 62, 8
    COMBOBOX        IDC_PM_TARGET, 78, 234, 64, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Deband", IDC_PM_DEBAND_LBL, 152, 236, 62, 8
    COMBOBOX        IDC_PM_DEBAND, 216, 234, 70, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Clean-up strength", IDC_PM_STRENGTH_LBL, 15, 252, 62, 8
    COMBOBOX        IDC_PM_STRENGTH, 78, 250, 64, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Deband strength", IDC_PM_DBSTR_LBL, 152, 252, 62, 8
    COMBOBOX        IDC_PM_DBSTR, 216, 250, 70, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "FG method", IDC_PM_FGMETHOD_LBL, 15, 268, 62, 8
    COMBOBOX        IDC_PM_FGMETHOD, 78, 266, 64, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Refresh (VRR)", IDC_PM_VRR_LBL, 152, 268, 62, 8
    COMBOBOX        IDC_PM_VRR, 216, 266, 70, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Upscaler", IDC_PM_UPSCALER_LBL, 15, 284, 62, 8
    COMBOBOX        IDC_PM_UPSCALER, 78, 282, 64, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "HDR method", IDC_PM_HDRMETHOD_LBL, 152, 284, 46, 8
    COMBOBOX        IDC_PM_HDRMETHOD, 200, 282, 86, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "Limit brightness on bright scenes", IDC_PM_HDRLIMIT, 152, 297, 140, 10
    LTEXT           "Display peak", IDC_PM_DISPPEAK_LBL, 15, 298, 62, 8
    COMBOBOX        IDC_PM_DISPPEAK, 78, 296, 64, 80, CBS_DROPDOWN | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_PM_CAPS_NOTE, 15, 311, 271, 24
    LTEXT           "", IDC_PM_DEBAND_NOW, 15, 337, 271, 8, SS_ENDELLIPSIS
    AUTOCHECKBOX    "Write a frame log (for troubleshooting)", IDC_PM_FRAMELOG, 15, 348, 200, 10
    PUSHBUTTON      "Import my PushFPS settings", IDC_PM_IMPORT, 15, 359, 120, 13
    LTEXT           "", IDC_PM_IMPORT_NOTE, 140, 361, 150, 8, SS_ENDELLIPSIS
    LTEXT           "On-screen status", IDC_PM_OSD_LBL, 15, 376, 62, 8
    COMBOBOX        IDC_PM_OSD, 78, 374, 64, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "On battery", IDC_PM_BATTERY_LBL, 152, 376, 62, 8
    COMBOBOX        IDC_PM_BATTERY, 216, 374, 70, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Turn on G-SYNC for MPC-HC", IDC_PM_GSYNC, 15, 389, 150, 13
    LTEXT           "", IDC_PM_GSYNC_NOTE, 170, 391, 116, 8, SS_ENDELLIPSIS
    LTEXT           "Subtitle hold", IDC_PM_SUBHOLD_LBL, 15, 406, 62, 8
    COMBOBOX        IDC_PM_SUBHOLD, 78, 404, 64, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Keeps burned-in subtitles steady in generated frames", IDC_PM_SUBHOLD_NOTE, 150, 403, 136, 17
END

IDD_PUSHMPC_ABOUT DIALOGEX 0, 0, 300, 352
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "PushMPC", -1, 7, 7, 286, 8
    LTEXT           "Versions", -1, 7, 22, 286, 8
    EDITTEXT        IDC_AB_VERSIONS, 7, 32, 286, 52, ES_MULTILINE | ES_READONLY | WS_VSCROLL
    LTEXT           "Credits", -1, 7, 90, 286, 8
    EDITTEXT        IDC_AB_CREDITS, 7, 100, 286, 92, ES_MULTILINE | ES_READONLY | WS_VSCROLL
    LTEXT           "Log folder", -1, 7, 198, 286, 8
    EDITTEXT        IDC_AB_LOGDIR, 7, 208, 220, 13, ES_READONLY | ES_AUTOHSCROLL
    PUSHBUTTON      "Open", IDC_AB_OPENLOG, 233, 208, 60, 13
    LTEXT           "Source code and updates:", -1, 7, 230, 286, 8
    EDITTEXT        IDC_AB_REPO, 7, 240, 286, 13, ES_READONLY | ES_AUTOHSCROLL
    PUSHBUTTON      "Copy diagnostics", IDC_AB_DIAG, 7, 260, 80, 14
    LTEXT           "", IDC_AB_DIAG_NOTE, 92, 263, 201, 8, SS_ENDELLIPSIS
    LTEXT           "Updates", -1, 7, 282, 286, 8
    LTEXT           "", IDC_AB_UPDATE, 7, 292, 286, 24
    AUTOCHECKBOX    "Automatic updates", IDC_AB_AUTOUPD, 7, 318, 90, 10
    LTEXT           "Channel", -1, 110, 319, 30, 8
    COMBOBOX        IDC_AB_CHANNEL, 142, 317, 60, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Check for updates", IDC_AB_CHECKUPD, 7, 333, 80, 14
    LTEXT           "", IDC_AB_UPD_NOTE, 92, 336, 201, 8, SS_ENDELLIPSIS
END

STRINGTABLE
BEGIN
    IDS_PUSHMPC_TITLE "PushMPC"
    IDS_PUSHMPC_ABOUT "About"
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION PUSHMPC_VERSION_COMMA
 PRODUCTVERSION PUSHMPC_VERSION_COMMA
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "PushMPC"
            VALUE "FileDescription", "PushMPC Filter: PushFPS video enhancement for MPC-HC"
            VALUE "FileVersion", PUSHMPC_VERSION_STR
            VALUE "InternalName", "PushMpcFilter"
            VALUE "LegalCopyright", "GPL-3.0-or-later"
            VALUE "OriginalFilename", "PushMpcFilter.ax"
            VALUE "ProductName", "PushMPC"
            VALUE "ProductVersion", PUSHMPC_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
