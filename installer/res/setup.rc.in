#include <winres.h>
#include "@PUSHMPC_SETUP_SRC@/src/version.h"
#include "@PUSHMPC_SETUP_SRC@/src/resource.h"
1 RT_MANIFEST "@PUSHMPC_SETUP_SRC@/res/setup.manifest"
IDI_APP ICON "@PUSHMPC_SETUP_SRC@/res/pushmpc.ico"
@PUSHMPC_PAYLOAD_LINE@
VS_VERSION_INFO VERSIONINFO
 FILEVERSION PUSHMPC_SETUP_VERSION_COMMA
 PRODUCTVERSION PUSHMPC_SETUP_VERSION_COMMA
 FILEFLAGSMASK 0x3fL
 FILEOS 0x40004L
 FILETYPE 0x1L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "PushMPC (community)"
      VALUE "FileDescription", "PushMPC setup"
      VALUE "FileVersion", PUSHMPC_SETUP_VERSION_STR
      VALUE "ProductName", "PushMPC"
      VALUE "ProductVersion", PUSHMPC_SETUP_VERSION_STR
      VALUE "LegalCopyright", "GPL-3.0-or-later, https://github.com/CptPakundo/PushMPC"
      VALUE "OriginalFilename", "PushMPC-Setup.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
