<?xml version="1.0" encoding="UTF-8"?>
<!-- PushMPC's own Kodi repository add-on. PREPARED, NOT PUBLISHED: the URLs only start to work once the project is public
     and the release workflow publishes the kodi-repo branch (kodi21/ and kodi22/: addons.xml, addons.xml.md5, <id>/<id>-<version>.zip per platform), which Kodi reads through raw.githubusercontent.com, (a public
     action that needs the user's explicit go). One <dir> per Kodi major, because the binary API differs. -->
<addon id="repository.pushmpc" name="PushMPC repository" version="1.0.0" provider-name="PushMPC">
  <extension point="xbmc.addon.repository" name="PushMPC repository">
    <dir minversion="21.0.0" maxversion="21.9.9">
      <info compressed="false">https://raw.githubusercontent.com/CptPakundo/PushMPC/kodi-repo/kodi21/addons.xml</info>
      <checksum>https://raw.githubusercontent.com/CptPakundo/PushMPC/kodi-repo/kodi21/addons.xml.md5</checksum>
      <datadir zip="true">https://raw.githubusercontent.com/CptPakundo/PushMPC/kodi-repo/kodi21/</datadir>
      <hashes>sha256</hashes>
    </dir>
    <dir minversion="22.0.0" maxversion="22.9.9">
      <info compressed="false">https://raw.githubusercontent.com/CptPakundo/PushMPC/kodi-repo/kodi22/addons.xml</info>
      <checksum>https://raw.githubusercontent.com/CptPakundo/PushMPC/kodi-repo/kodi22/addons.xml.md5</checksum>
      <datadir zip="true">https://raw.githubusercontent.com/CptPakundo/PushMPC/kodi-repo/kodi22/</datadir>
      <hashes>sha256</hashes>
    </dir>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">PushMPC add-ons for Kodi</summary>
    <description lang="en_GB">Installs and updates inputstream.pushmpc, PushMPC's frame generation for Kodi's own player.</description>
    <license>GPL-3.0-or-later</license>
    <platform>all</platform>
  </extension>
</addon>
