 }
 
+// The pair call: FSR's frame generation interpolates between the previous present and this one, so a pair (a, b) is a
+// present of a with reset (no history across it; its output is discarded) followed by a present of b. A pair that
+// starts where the last one ended (continues) is one dispatch.
+bool FsrFgPresenter::generatePair(ID3D12GraphicsCommandList* list, ID3D12Resource* a, ID3D12Resource* b,
+                                  ID3D12Resource* motion, ID3D12Resource* depth, ID3D12Resource* output,
+                                  bool continues, float elapsedMs) {
+#ifdef VEYRA_HAS_FSR
+    auto& p = *p_;
+    if (!p.available || p.failed || !list || !a || !b || !output) return false;
+    if (!continues) {
+        if (!p.pairScratch) {
+            ID3D12Device* dev = nullptr;
+            if (FAILED(output->GetDevice(IID_PPV_ARGS(&dev)))) return false;
+            D3D12_RESOURCE_DESC d = output->GetDesc();
+            d.Alignment = 0; d.Flags |= D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS;
+            d.Flags &= ~D3D12_RESOURCE_FLAG_ALLOW_SIMULTANEOUS_ACCESS;
+            D3D12_HEAP_PROPERTIES hp{}; hp.Type = D3D12_HEAP_TYPE_DEFAULT;
+            const HRESULT hr = dev->CreateCommittedResource(&hp, D3D12_HEAP_FLAG_NONE, &d, D3D12_RESOURCE_STATE_COMMON, nullptr, IID_PPV_ARGS(&p.pairScratch));
+            dev->Release();
+            if (FAILED(hr)) { p.pairScratch = nullptr; log::error("fsr-fg", "pair scratch texture failed"); return false; }
+        }
+        if (!generate(list, a, motion, depth, p.pairScratch, true, elapsedMs)) return false;
+    }
+    return generate(list, b, motion, depth, output, false, elapsedMs);
+#else
+    (void)list; (void)a; (void)b; (void)motion; (void)depth; (void)output; (void)continues; (void)elapsedMs;
+    return false;
+#endif
+}
+
 void FsrFgPresenter::shutdown() {
 #ifdef VEYRA_HAS_FSR
     auto& p = *p_;
@@ -263,6 +294,7 @@ void FsrFgPresenter::shutdown() {
         log::info("fsr-fg", std::format("independent context destroyed result={}", returnName(result)));
         p.fgContext = nullptr;
     }
+    if (p.pairScratch) { p.pairScratch->Release(); p.pairScratch = nullptr; }
     p.available = false;
 #endif
 }
