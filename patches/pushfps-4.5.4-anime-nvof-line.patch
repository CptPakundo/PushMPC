diff --git a/src/pipeline/PushMpcLinePass.cpp b/src/pipeline/PushMpcLinePass.cpp
new file mode 100644
index 00000000..c726707d
--- /dev/null
+++ b/src/pipeline/PushMpcLinePass.cpp
@@ -0,0 +1,68 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// PushMPC (anime round 5): line-art protection for NVOF frame generation (PushMpcLinePass.h, shaders/PushMpcLine.hlsl).
+#include "veyra/pipeline/PushMpcLinePass.h"
+#include <bit>
+#include <format>
+
+namespace veyra::pipeline {
+namespace {
+constexpr D3D12_RESOURCE_STATES kRead = D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE;
+constexpr D3D12_RESOURCE_STATES kWrite = D3D12_RESOURCE_STATE_UNORDERED_ACCESS;
+}
+
+bool PushMpcLinePass::initialize(ID3D12Device* device, uint32_t width, uint32_t height, DXGI_FORMAT format, unsigned outputMode) {
+    if (!device || !width || !height || format == DXGI_FORMAT_UNKNOWN) return false;
+    width_ = width; height_ = height; format_ = format; outputMode_ = outputMode;
+    copy_ = makeTexture(device, width_, height_, format_, false);
+    if (!copy_) return false;
+    std::vector<uint8_t> cs;
+    if (!pass_.loadShader("PushMpcLine.dxil", cs) || !pass_.create(device, cs, kMaxGenerated * 2 * kStride, 4, 1, kConstants)) return false;
+    veyra::log::info("nvof-line", std::format("created {}x{} mode={}", width_, height_, outputMode_));
+    return true;
+}
+
+void PushMpcLinePass::createViews(ID3D12Device* device, DescriptorStager& stager, ID3D12Resource* const real[2], ID3D12Resource* flow,
+                                  ID3D12Resource* const* generated, unsigned generatedCount) {
+    real_[0] = real[0]; real_[1] = real[1]; flow_ = flow;
+    generatedCount_ = std::min<unsigned>(generatedCount, kMaxGenerated);
+    for (unsigned slot = 0; slot < kMaxGenerated; ++slot) writable_[slot] = false;
+    if (!flow_) return;
+    for (unsigned slot = 0; slot < generatedCount_; ++slot) {
+        generated_[slot] = generated[slot];
+        if (!generated_[slot]) continue;
+        const auto desc = generated_[slot]->GetDesc();
+        if (!(desc.Flags & D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS) || desc.Format != format_ || desc.Width != width_ || desc.Height != height_) continue;
+        for (unsigned parity = 0; parity < 2; ++parity) {
+            const UINT base = (slot * 2 + parity) * kStride;
+            stager.stageSrv(copy_.Get(), nullptr, pass_.heap.Get(), base);
+            stager.stageSrv(real_[1 - parity], nullptr, pass_.heap.Get(), base + 1);
+            stager.stageSrv(real_[parity], nullptr, pass_.heap.Get(), base + 2);
+            stager.stageSrv(flow_, nullptr, pass_.heap.Get(), base + 3);
+            makeUav(device, generated_[slot], format_, cpuHandleOf(pass_, base + 4));
+        }
+        writable_[slot] = true;
+    }
+}
+
+bool PushMpcLinePass::compose(ID3D12GraphicsCommandList* list, StateTracker& tracker, unsigned slot, unsigned parity, float t) {
+    if (!list || parity > 1 || !composes(slot) || !real_[0] || !real_[1]) return false;
+    auto* generated = generated_[slot];
+    tracker.transition(list, generated, D3D12_RESOURCE_STATE_COPY_SOURCE);
+    tracker.transition(list, copy_.Get(), D3D12_RESOURCE_STATE_COPY_DEST);
+    list->CopyResource(copy_.Get(), generated);
+    ID3D12Resource* const reads[] = {copy_.Get(), real_[0], real_[1], flow_};
+    for (ID3D12Resource* r : reads) tracker.transition(list, r, kRead);
+    tracker.transition(list, generated, kWrite);
+    float c[kConstants]{};
+    c[0] = std::bit_cast<float>(width_); c[1] = std::bit_cast<float>(height_); c[2] = std::bit_cast<float>(uint32_t(outputMode_));
+    c[4] = std::clamp(t, 0.0f, 1.0f);
+    const UINT base = (slot * 2 + parity) * kStride;
+    pass_.bind(list, c, gpuHandleOf(pass_, base).ptr, gpuHandleOf(pass_, base + 4).ptr);
+    list->Dispatch((width_ + 7) / 8, (height_ + 7) / 8, 1);
+    tracker.uavBarrier(list, generated);
+    tracker.transition(list, generated, D3D12_RESOURCE_STATE_COMMON);
+    for (ID3D12Resource* r : reads) tracker.transition(list, r, D3D12_RESOURCE_STATE_COMMON);
+    ++composed_;
+    return true;
+}
+}
