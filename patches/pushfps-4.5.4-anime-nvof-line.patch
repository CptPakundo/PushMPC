+++ b/src/pipeline/PushMpcLinePass.cpp
@@ -0,0 +1,140 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// PushMPC (anime round 5): line art for NVOF frame generation (PushMpcLinePass.h, shaders/PushMpcLine.hlsl,
+// shaders/PushMpcLineDepth.hlsl).
+#include "veyra/pipeline/PushMpcLinePass.h"
+#include <algorithm>
+#include <bit>
+#include <format>
+
+namespace veyra::pipeline {
+namespace {
+constexpr D3D12_RESOURCE_STATES kRead = D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE;
+constexpr D3D12_RESOURCE_STATES kWrite = D3D12_RESOURCE_STATE_UNORDERED_ACCESS;
+constexpr UINT kTile = 16;
+}
+
+bool PushMpcLinePass::initialize(ID3D12Device* device, uint32_t width, uint32_t height, DXGI_FORMAT format, unsigned outputMode, bool withDepth) {
+    if (!device || !width || !height || format == DXGI_FORMAT_UNKNOWN) return false;
+    width_ = width; height_ = height; format_ = format; outputMode_ = outputMode;
+    copy_ = makeTexture(device, width_, height_, format_, false);
+    if (!copy_) return false;
+    std::vector<uint8_t> cs;
+    // s0 point / s1 linear clamp samplers (the warps sample between pixels)
+    if (!pass_.loadShader("PushMpcLine.dxil", cs) || !pass_.create(device, cs, (kMaxGenerated * 2 + kPairSets) * kStride, 4, 1, kConstants, 0, true)) return false;
+    if (withDepth) {
+        std::vector<uint8_t> ds;
+        depth_ = makeTexture(device, width_, height_, DXGI_FORMAT_R32_FLOAT, true);
+        if (!depth_ || !depthPass_.loadShader("PushMpcLineDepth.dxil", ds) || !depthPass_.create(device, ds, 4, 1, 1, kConstants)) {
+            depth_.Reset();
+            veyra::log::warn("nvof-line", "line depth unavailable; frame generation keeps the constant depth");
+        }
+    }
+    veyra::log::info("nvof-line", std::format("created {}x{} mode={} depth={}", width_, height_, outputMode_, depth_ ? 1 : 0));
+    return true;
+}
+
+void PushMpcLinePass::createViews(ID3D12Device* device, DescriptorStager& stager, ID3D12Resource* const real[2], ID3D12Resource* flow,
+                                  ID3D12Resource* const* generated, unsigned generatedCount) {
+    real_[0] = real[0]; real_[1] = real[1]; flow_ = flow;
+    generatedCount_ = std::min<unsigned>(generatedCount, kMaxGenerated);
+    for (unsigned slot = 0; slot < kMaxGenerated; ++slot) writable_[slot] = false;
+    depthViews_ = false;
+    if (depth_ && real_[0] && real_[1]) {
+        for (unsigned parity = 0; parity < 2; ++parity) {
+            stager.stageSrv(real_[parity], nullptr, depthPass_.heap.Get(), parity * 2);
+            makeUav(device, depth_.Get(), DXGI_FORMAT_R32_FLOAT, cpuHandleOf(depthPass_, parity * 2 + 1));
+        }
+        depthViews_ = true;
+    }
+    if (!flow_) return;
+    for (unsigned slot = 0; slot < generatedCount_; ++slot) {
+        generated_[slot] = generated[slot];
+        if (!generated_[slot]) continue;
+        const auto desc = generated_[slot]->GetDesc();
+        if (!(desc.Flags & D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS) || desc.Format != format_ || desc.Width != width_ || desc.Height != height_) continue;
+        for (unsigned parity = 0; parity < 2; ++parity) {
+            const UINT base = (slot * 2 + parity) * kStride;
+            stager.stageSrv(copy_.Get(), nullptr, pass_.heap.Get(), base);
+            stager.stageSrv(real_[1 - parity], nullptr, pass_.heap.Get(), base + 1);
+            stager.stageSrv(real_[parity], nullptr, pass_.heap.Get(), base + 2);
+            stager.stageSrv(flow_, nullptr, pass_.heap.Get(), base + 3);
+            makeUav(device, generated_[slot], format_, cpuHandleOf(pass_, base + 4));
+        }
+        writable_[slot] = true;
+    }
+}
+
+bool PushMpcLinePass::writeDepth(ID3D12GraphicsCommandList* list, StateTracker& tracker, unsigned parity) {
+    if (!list || parity > 1 || !depthReady()) return false;
+    tracker.transition(list, real_[parity], kRead);
+    tracker.transition(list, depth_.Get(), kWrite);
+    float c[kConstants]{};
+    c[0] = std::bit_cast<float>(width_); c[1] = std::bit_cast<float>(height_); c[2] = std::bit_cast<float>(uint32_t(outputMode_));
+    c[4] = kNearDepth; c[5] = kFarDepth; c[6] = kDepthTau;
+    depthPass_.bind(list, c, gpuHandleOf(depthPass_, parity * 2).ptr, gpuHandleOf(depthPass_, parity * 2 + 1).ptr);
+    list->Dispatch((width_ + kTile - 1) / kTile, (height_ + kTile - 1) / kTile, 1);
+    tracker.uavBarrier(list, depth_.Get());
+    tracker.transition(list, depth_.Get(), kRead);   // the real frame stays readable: the FG dispatch reads it next
+    ++depthWritten_;
+    return true;
+}
+
+void PushMpcLinePass::dispatchLine(ID3D12GraphicsCommandList* list, UINT base, bool hasFlow, float t) {
+    float c[kConstants]{};
+    c[0] = std::bit_cast<float>(width_); c[1] = std::bit_cast<float>(height_); c[2] = std::bit_cast<float>(uint32_t(outputMode_));
+    c[3] = std::bit_cast<float>(uint32_t(hasFlow ? 1u : 0u));
+    c[4] = std::clamp(t, 0.0f, 1.0f);
+    pass_.bind(list, c, gpuHandleOf(pass_, base).ptr, gpuHandleOf(pass_, base + 4).ptr);
+    list->Dispatch((width_ + kTile - 1) / kTile, (height_ + kTile - 1) / kTile, 1);
+}
+
+bool PushMpcLinePass::compose(ID3D12GraphicsCommandList* list, StateTracker& tracker, unsigned slot, unsigned parity, float t) {
+    if (!list || parity > 1 || !composes(slot) || !real_[0] || !real_[1]) return false;
+    auto* generated = generated_[slot];
+    tracker.transition(list, generated, D3D12_RESOURCE_STATE_COPY_SOURCE);
+    tracker.transition(list, copy_.Get(), D3D12_RESOURCE_STATE_COPY_DEST);
+    list->CopyResource(copy_.Get(), generated);
+    ID3D12Resource* const reads[] = {copy_.Get(), real_[0], real_[1], flow_};
+    for (ID3D12Resource* r : reads) tracker.transition(list, r, kRead);
+    tracker.transition(list, generated, kWrite);
+    dispatchLine(list, (slot * 2 + parity) * kStride, true, t);
+    tracker.uavBarrier(list, generated);
+    tracker.transition(list, generated, D3D12_RESOURCE_STATE_COMMON);
+    for (ID3D12Resource* r : reads) tracker.transition(list, r, D3D12_RESOURCE_STATE_COMMON);
+    ++composed_;
+    return true;
+}
+
+bool PushMpcLinePass::composePair(ID3D12Device* device, DescriptorStager& stager, ID3D12GraphicsCommandList* list,
+                                  ID3D12Resource* a, ID3D12Resource* b, ID3D12Resource* flow, ID3D12Resource* out, float t) {
+    if (!device || !list || !a || !b || !out || !copy_) return false;
+    const auto od = out->GetDesc();
+    if (!(od.Flags & D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS) || od.Format != format_ || od.Width != width_ || od.Height != height_) return false;
+    const UINT base = (kMaxGenerated * 2 + pairNext_) * kStride;
+    pairNext_ = (pairNext_ + 1) % kPairSets;
+    stager.stageSrv(copy_.Get(), nullptr, pass_.heap.Get(), base);
+    stager.stageSrv(a, nullptr, pass_.heap.Get(), base + 1);
+    stager.stageSrv(b, nullptr, pass_.heap.Get(), base + 2);
+    if (flow) stager.stageSrv(flow, nullptr, pass_.heap.Get(), base + 3);
+    else {
+        D3D12_SHADER_RESOURCE_VIEW_DESC nd{};   // a null view (the shader does not read it without motion)
+        nd.Format = DXGI_FORMAT_R16G16_FLOAT; nd.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+        nd.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING; nd.Texture2D.MipLevels = 1;
+        stager.stageSrv(nullptr, &nd, pass_.heap.Get(), base + 3);
+    }
+    makeUav(device, out, format_, cpuHandleOf(pass_, base + 4));
+    StateTracker tr;
+    ID3D12Resource* const all[] = {copy_.Get(), a, b, flow, out};
+    for (ID3D12Resource* r : all) if (r) tr.set(r, D3D12_RESOURCE_STATE_COMMON);
+    tr.transition(list, out, D3D12_RESOURCE_STATE_COPY_SOURCE);
+    tr.transition(list, copy_.Get(), D3D12_RESOURCE_STATE_COPY_DEST);
+    list->CopyResource(copy_.Get(), out);
+    for (ID3D12Resource* r : {copy_.Get(), a, b, flow}) if (r) tr.transition(list, r, kRead);
+    tr.transition(list, out, kWrite);
+    dispatchLine(list, base, flow != nullptr, t);
+    tr.uavBarrier(list, out);
+    for (ID3D12Resource* r : all) if (r) tr.transition(list, r, D3D12_RESOURCE_STATE_COMMON);
+    ++composed_;
+    return true;
+}
+}
