diff --git a/include/veyra/pipeline/PushMpcLinePass.h b/include/veyra/pipeline/PushMpcLinePass.h
new file mode 100644
index 00000000..d73115c5
--- /dev/null
+++ b/include/veyra/pipeline/PushMpcLinePass.h
@@ -0,0 +1,42 @@
+#pragma once
+// SPDX-License-Identifier: GPL-3.0-or-later
+// PushMPC (anime round 5): line-art protection for NVOF frame generation (shaders/PushMpcLine.hlsl says the rule).
+// One dispatch per generated frame, in place, after FidelityFX made it: doubled lines become one line from the nearer
+// real frame. Created by the graph only for NVOF FG (FSR frame interpolation fed with the graph's NVOF motion) and only
+// while lineArtWanted(); compose runs while setLineCompose(true) (pushcore: animation, budget).
+#include "veyra/pipeline/GpuPassUtils.h"
+#include <string>
+
+namespace veyra::pipeline {
+namespace lineart {
+inline bool& wantedStore() { static bool wanted = false; return wanted; }
+inline void setWanted(bool on) { wantedStore() = on; }
+inline bool wanted() { return wantedStore(); }
+}
+#define PUSHMPC_NVOF_LINE_PASS 1
+
+class PushMpcLinePass {
+public:
+    static constexpr UINT kConstants = 8;
+    static constexpr UINT kMaxGenerated = 32;
+    static constexpr UINT kStride = 5;   // per (slot, parity): t0 copy, t1 older real, t2 newer real, t3 flow, u0 generated
+    bool initialize(ID3D12Device* device, uint32_t width, uint32_t height, DXGI_FORMAT format, unsigned outputMode);
+    void createViews(ID3D12Device* device, DescriptorStager& stager, ID3D12Resource* const real[2], ID3D12Resource* flow,
+                     ID3D12Resource* const* generated, unsigned generatedCount);
+    // generated[slot] lies `t` of the way from real[1 - parity] to real[parity]
+    bool compose(ID3D12GraphicsCommandList* list, StateTracker& tracker, unsigned slot, unsigned parity, float t);
+    bool composes(unsigned slot) const { return slot < generatedCount_ && writable_[slot] && flow_; }
+    uint64_t composed() const { return composed_; }
+private:
+    uint32_t width_ = 0, height_ = 0;
+    unsigned outputMode_ = 0, generatedCount_ = 0;
+    DXGI_FORMAT format_ = DXGI_FORMAT_UNKNOWN;
+    ComputePass pass_;
+    ComPtr<ID3D12Resource> copy_;
+    ID3D12Resource* real_[2]{};
+    ID3D12Resource* flow_ = nullptr;
+    ID3D12Resource* generated_[kMaxGenerated]{};
+    bool writable_[kMaxGenerated]{};
+    uint64_t composed_ = 0;
+};
+}
diff --git a/shaders/PushMpcLine.hlsl b/shaders/PushMpcLine.hlsl
new file mode 100644
index 00000000..fc3f2aa3
--- /dev/null
+++ b/shaders/PushMpcLine.hlsl
@@ -0,0 +1,81 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// PushMPC (anime round 5): line-art protection for NVOF frame generation. NVOF FG is NVIDIA's optical flow feeding
+// FidelityFX frame interpolation; the blend itself is inside AMD's provider, so a doubled line (two faint copies of one
+// drawn line, measured on a big jump between two drawings) is repaired after it, with the flow the graph gave it:
+//   wA = A sampled at x + s * t * f(x), wB = B sampled at x - s * (1 - t) * f(x)   (f: the graph's FG motion, pixels)
+// On a line pixel (3x3 black top-hat of luma above kLineTau in wA or wB) where wA and wB disagree (luma > kLineDelta)
+// and the generated pixel G is the blend of the two (within half their difference of lerp(wB, wA, 1 - t): the doubled-
+// line signature), G becomes lerp(wB, wA, smoothstep(0.35, 0.65, 1 - t)): one sharp line from the nearer frame.
+// The flow's sign convention is taken per pixel from the two hypotheses (s = +1 / -1), the one whose blend explains G
+// better over 3x3; where neither does, G stays. Same rule and constants as pmml's synth_line (make_graphs.py).
+Texture2D<float4> genTex : register(t0);   // the generated frame as it was made (a copy)
+Texture2D<float4> realA : register(t1);    // the older real frame
+Texture2D<float4> realB : register(t2);    // the newer
+Texture2D<float2> flow : register(t3);     // the FG motion at the picture's size, pixels
+SamplerState linearClamp : register(s1);   // ComputePass: s0 point, s1 linear (clamp)
+RWTexture2D<float4> outTex : register(u0); // the generated frame
+cbuffer Constants : register(b0) {
+    uint width, height, outputMode, pad0;
+    float t, pad1, pad2, pad3;
+};
+static const float kLineTau = 0.05, kLineDelta = 0.04;
+
+float perceptual1(float v) { return outputMode == 1 ? sqrt(max(v, 0) / 2.5) : v; }
+float lumaOf(float3 c) { return 0.2126 * perceptual1(c.r) + 0.7152 * perceptual1(c.g) + 0.0722 * perceptual1(c.b); }
+float3 warp(Texture2D<float4> tex, float2 p, float2 d) { return tex.SampleLevel(linearClamp, (p + 0.5 + d) / float2(width, height), 0).rgb; }
+
+// luma of both warps at p + o, for one sign hypothesis
+void warps(int2 p, float s, out float3 a, out float3 b) {
+    const float2 f = flow[clamp(p, int2(0, 0), int2(width - 1, height - 1))];
+    a = warp(realA, float2(p), s * t * f);
+    b = warp(realB, float2(p), -s * (1.0 - t) * f);
+}
+float topHat(int2 p, float s, bool useA) {
+    float closing = 1e30;
+    [unroll] for (int j = -1; j <= 1; ++j)
+        [unroll] for (int i = -1; i <= 1; ++i) {
+            float dil = -1e30;
+            [unroll] for (int v = -1; v <= 1; ++v)
+                [unroll] for (int u = -1; u <= 1; ++u) {
+                    float3 a, b; warps(p + int2(i + u, j + v), s, a, b);
+                    dil = max(dil, lumaOf(useA ? a : b));
+                }
+            closing = min(closing, dil);
+        }
+    float3 a, b; warps(p, s, a, b);
+    return closing - lumaOf(useA ? a : b);
+}
+// how far G is from the blend of the two warps over 3x3 (luma)
+float blendError(int2 p, float s) {
+    float e = 0;
+    [unroll] for (int j = -1; j <= 1; ++j)
+        [unroll] for (int i = -1; i <= 1; ++i) {
+            const int2 q = clamp(p + int2(i, j), int2(0, 0), int2(width - 1, height - 1));
+            float3 a, b; warps(q, s, a, b);
+            e += abs(lumaOf(genTex[q].rgb) - lumaOf(lerp(b, a, 1.0 - t)));
+        }
+    return e / 9.0;
+}
+
+[numthreads(8, 8, 1)]
+void main(uint3 id : SV_DispatchThreadID) {
+    if (id.x >= width || id.y >= height) return;
+    const int2 p = int2(id.xy);
+    float3 a, b;
+    warps(p, 1.0, a, b);
+    float3 a2, b2;
+    warps(p, -1.0, a2, b2);
+    // cheap first test: the two warps disagree here under either sign (most pixels stop here)
+    if (abs(lumaOf(a) - lumaOf(b)) <= kLineDelta && abs(lumaOf(a2) - lumaOf(b2)) <= kLineDelta) return;
+    const float ep = blendError(p, 1.0), em = blendError(p, -1.0);
+    const float s = ep <= em ? 1.0 : -1.0;
+    if (s < 0) { a = a2; b = b2; }
+    const float la = lumaOf(a), lb = lumaOf(b);
+    if (abs(la - lb) <= kLineDelta) return;
+    if (!(topHat(p, s, true) > kLineTau || topHat(p, s, false) > kLineTau)) return;
+    const float3 g = genTex[p].rgb;
+    if (abs(lumaOf(g) - lumaOf(lerp(b, a, 1.0 - t))) > 0.5 * abs(la - lb)) return;   // not a blend of the two: leave it
+    const float q = saturate(((1.0 - t) - 0.35) / 0.3);
+    const float m = q * q * (3.0 - 2.0 * q);
+    outTex[p] = float4(lerp(b, a, m), genTex[p].a);
+}
