+void CutGuard::record(ID3D12GraphicsCommandList* list, ID3D12Resource* previous, ID3D12Resource* current, uint32_t rowPitch,
+                      unsigned parity, bool compare) {
+    if (!ready() || !list) return;
+    drainTrace(false);
+    D3D12_RESOURCE_BARRIER barrier{};
+    if (resultsState_ != D3D12_RESOURCE_STATE_UNORDERED_ACCESS) {
+        transition(barrier, results_.Get(), resultsState_, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+        list->ResourceBarrier(1, &barrier);
+    }
+    const core::SceneCadenceAnalyzer::Config scene{};
+    std::array<uint32_t, kConstants> c{};
+    c[0] = width_; c[1] = height_; c[2] = rowPitch; c[3] = format_ == DXGI_FORMAT_R10G10B10A2_UNORM ? 1u : 0u; c[4] = parity & 1u; c[5] = compare ? 1u : 0u;
+    const float f[] = {float(scene.sceneCutSadThreshold), float(scene.sceneCutHistogramThreshold), float(scene.replacementSadThreshold),
+                       float(scene.replacementHistogramThreshold), float(scene.flashSadThreshold), float(scene.flashHistogramThreshold),
+                       params_.adaptive ? params_.adaptiveMin : 0.0f, params_.adaptiveRatio, params_.adaptiveHistogram16, params_.baselineAttack,
+                       params_.baselineRelease, params_.darkMean, params_.darkMin, params_.darkRatio, params_.darkHistogram, params_.warpVeto,
+                       params_.warpMin, params_.warpRatio, params_.warpHistogram, params_.holdSad, params_.barLuma};
+    std::memcpy(c.data() + 6, f, sizeof(f));   // 6..26
+    c[27] = params_.barTaps;
+    c[28] = params_.adaptive ? params_.features : 0u;
+    const float area[] = {params_.areaX0, params_.areaY0, params_.areaX1, params_.areaY1};
+    std::memcpy(c.data() + 29, area, sizeof(area));
+    const float spike[] = {params_.spikeRatio, params_.spikeMin, params_.spikeHistogram, params_.spikeHistogramRatio};
+    std::memcpy(c.data() + 33, spike, sizeof(spike));
+    const float more[] = {params_.mcVeto, params_.mcMin, params_.mcRatio, params_.barChangeBins, params_.barPicture};
+    std::memcpy(c.data() + 37, more, sizeof(more));
+    c[42] = params_.barPersist;
+    std::memcpy(c.data() + 43, &params_.scoreThreshold, sizeof(float));
+    const uint32_t flow = (params_.features & 128u) ? flowPending_ : 0u;
+    std::memcpy(c.data() + 49, &params_.scoreThresholdFlow, sizeof(float));
+    c[44] = flow; c[45] = flowFwd_.fp.Footprint.RowPitch; c[46] = flowCost_.fp.Footprint.RowPitch; c[47] = flowGrid_; c[48] = flowExtent_;
+    const uint32_t tsSlot = traceNext_ % kTraceSlots;
+    const bool timed = trace_ && tsHeap_ && tsBuffer_;
+    if (timed) list->EndQuery(tsHeap_.Get(), D3D12_QUERY_TYPE_TIMESTAMP, tsSlot * 2);
+    // Fourier-Mellin only where NVOF's measures are missing (it added nothing beside them in the calibration)
+    const bool fmRun = (params_.features & 256u) && fmPso_ && compare && !((params_.features & 128u) && (flowPending_ & 6u) == 6u);
+    if (fmRun) recordFourierMellin(list, previous, current, rowPitch);
+    list->SetComputeRootSignature(root_.Get());
+    list->SetPipelineState(pso_.Get());
+    list->SetComputeRoot32BitConstants(0, kConstants, c.data(), 0);
+    list->SetComputeRootShaderResourceView(1, previous->GetGPUVirtualAddress());
+    list->SetComputeRootShaderResourceView(2, current->GetGPUVirtualAddress());
+    list->SetComputeRootUnorderedAccessView(3, results_->GetGPUVirtualAddress());
+    // the flow buffers (unused ones point at the previous frame, which is already a shader resource here)
+    list->SetComputeRootShaderResourceView(4, (flow & 1u) && flowFwd_.buffer ? flowFwd_.buffer->GetGPUVirtualAddress() : previous->GetGPUVirtualAddress());
+    list->SetComputeRootShaderResourceView(5, (flow & 2u) && flowCost_.buffer ? flowCost_.buffer->GetGPUVirtualAddress() : previous->GetGPUVirtualAddress());
+    list->SetComputeRootShaderResourceView(6, (flow & 4u) && flowBwd_.buffer ? flowBwd_.buffer->GetGPUVirtualAddress() : previous->GetGPUVirtualAddress());
+    flowPending_ = 0;
+    list->Dispatch(1, 1, 1);
+    if (timed) {
+        list->EndQuery(tsHeap_.Get(), D3D12_QUERY_TYPE_TIMESTAMP, tsSlot * 2 + 1);
+        list->ResolveQueryData(tsHeap_.Get(), D3D12_QUERY_TYPE_TIMESTAMP, tsSlot * 2, 2, tsBuffer_.Get(), uint64_t(tsSlot) * 16);
+    }
+    D3D12_RESOURCE_BARRIER uav{}; uav.Type = D3D12_RESOURCE_BARRIER_TYPE_UAV; uav.UAV.pResource = results_.Get();
+    list->ResourceBarrier(1, &uav);
+    resultsState_ = D3D12_RESOURCE_STATE_UNORDERED_ACCESS;
+    traceCopy(list);
+    toPredication(list);
+}
