+void EnhanceGraph::holdOnCut(ID3D12GraphicsCommandList* list,unsigned generatedSlot,unsigned parity,bool resetFg,unsigned sub,unsigned multiplier)
+{
+    if(!cutGuard_||resetFg||generatedSlot>=kGeneratedPoolSlots||!genFrame_[generatedSlot]||!videoFrame_[1-parity]||!videoFrame_[parity])return;
+    // PushMPC: nearest-real (soft band): the generated frames after the pair's midpoint show B
+    const bool late=2u*sub>multiplier;
+    tracker_.transition(list,genFrame_[generatedSlot].Get(),D3D12_RESOURCE_STATE_COPY_DEST);
+    tracker_.transition(list,videoFrame_[1-parity].Get(),D3D12_RESOURCE_STATE_COPY_SOURCE);
+    tracker_.transition(list,videoFrame_[parity].Get(),D3D12_RESOURCE_STATE_COPY_SOURCE);
+    cutGuard_->holdOnCut(list,genFrame_[generatedSlot].Get(),videoFrame_[1-parity].Get(),parity,videoFrame_[parity].Get(),late);
+    tracker_.transition(list,videoFrame_[1-parity].Get(),D3D12_RESOURCE_STATE_COMMON);
+    tracker_.transition(list,videoFrame_[parity].Get(),D3D12_RESOURCE_STATE_COMMON);
