+        if (ok) ok = SUCCEEDED(device->CreateCommittedResource(&sh, D3D12_HEAP_FLAG_NONE, &sd, D3D12_RESOURCE_STATE_UNORDERED_ACCESS, nullptr, IID_PPV_ARGS(&fmScratch_)));
