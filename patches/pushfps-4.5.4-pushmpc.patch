diff --git a/include/veyra/pipeline/PushMpcCutGuard.h b/include/veyra/pipeline/PushMpcCutGuard.h
new file mode 100644
index 00000000..19ea835a
--- /dev/null
+++ b/include/veyra/pipeline/PushMpcCutGuard.h
@@ -0,0 +1,122 @@
+// SPDX-License-Identifier: GPL-3.0-only
+// PushMPC (local addition, not upstream): the scene-cut guard for every frame-generation backend.
+//
+// One GPU pair test (shaders/VfgShotChange.hlsl, one 256-thread group per real frame, no readback) decides per pair
+// whether A and B belong to different shots; the generated frames of a cut pair are then replaced, by predicated
+// copies, with the pair's first real frame A held. VfgBackend runs the test on its own encoded input buffers; the
+// other backends (DLSS-G, PushFlow, FSR FG, AMD FRC) give the guard their real output frames, which it copies into
+// two byte buffers of its own (one per parity) for the same shader.
+//
+// Rules and thresholds: see VfgShotChange.hlsl. Every threshold can be overridden for calibration runs with
+// PUSHMPC_CUT_PARAMS="name=value;..." (names as in Params), the rule set with PUSHMPC_CUT_FEATURES (bit 0 bars, 1 profile warp
+// check, 2 dark rule, 3 spike rule), and PUSHMPC_CUT_TRACE=1 logs every pair's measures ("cut-guard" log lines; a readback ring
+// that never waits on the GPU).
+#pragma once
+#include <d3d12.h>
+#include <wrl/client.h>
+#include <array>
+#include <cstdint>
+#include <deque>
+#include <atomic>
+#include <string>
+
+namespace veyra::pipeline {
+class CutGuard {
+public:
+    struct Params {
+        float adaptiveMin = 0.08f, adaptiveRatio = 5.0f, adaptiveHistogram16 = 0.15f, baselineAttack = 0.5f, baselineRelease = 0.1f;
+        float darkMean = 0.25f, darkMin = 0.7f, darkRatio = 2.5f, darkHistogram = 0.32f;
+        float spikeRatio = 3.0f, spikeMin = 0.09f, spikeHistogram = 0.27f, spikeHistogramRatio = 4.0f;
+        float warpVeto = 0.5f, warpMin = 0.08f, warpRatio = 5.0f, warpHistogram = 0.15f, holdSad = 0.004f;
+        float mcVeto = 0.5f, mcMin = 0.06f, mcRatio = 4.0f;                  // block matching
+        float barChangeBins = 2.0f, barPicture = 0.12f; uint32_t barPersist = 6;   // bar geometry, every frame
+        float barLuma = 0.10f; uint32_t barTaps = 3;   // a bar bin: at most barTaps of 32 taps above barLuma (watermarks)
+        float scoreThresholdFlow = 6.3f;               // with NVOF (round 4): non-cuts' maximum 5.48, new hits 6.73 / 9.17 (960-px flow)
+        float scoreThreshold = 6.6f;                   // scene score (round 3): between the non-cuts' maximum 5.7 and the new hits 7.6 / 9.1
+        // bars (1), dark rule (4), spike rule (8), bar-change cut (32), scene score (64); off by default after the
+        // calibration: the profile warp check (2) and block matching (16), which added no hit without a false hold
+        // (PUSHMPC_CUT_FEATURES turns them on)
+        uint32_t features = 493;   // + 128: NVOF's flow when the graph runs it (cutGuard 3); + 256: Fourier-Mellin
+        float areaX0 = 0, areaY0 = 0, areaX1 = 0, areaY1 = 0;   // fixed active area (fractions); x1 <= x0 = detect
+        bool adaptive = true;                                     // false: PushFPS's fixed rules only
+    };
+    static constexpr uint64_t kResultBytes = 1472;   // 1408..: Fourier-Mellin results
+
+    // Loads the shader and creates the result buffer (state COMMON). With ownInputs the guard also creates two byte
+    // buffers for width x height frames of `format` (R8G8B8A8_UNORM or R10G10B10A2_UNORM).
+    bool initialize(ID3D12Device* device, uint32_t width, uint32_t height, DXGI_FORMAT format, bool ownInputs, const char* who);
+    bool ready() const { return pso_ != nullptr; }
+    // Records the pair test. previous/current: byte buffers with the given row pitch, already in
+    // NON_PIXEL_SHADER_RESOURCE. Leaves the result buffer in PREDICATION. compare=false: no valid A (reset).
+    void record(ID3D12GraphicsCommandList* list, ID3D12Resource* previous, ID3D12Resource* current, uint32_t rowPitch,
+                unsigned parity, bool compare);
+    // Own inputs (the non-VFG backends): copies `texture` (the real frame of this parity, in COPY_SOURCE) into the
+    // guard's buffer of that parity and records the test against the other parity's buffer. Both buffers end in COMMON.
+    void captureAndTest(ID3D12GraphicsCommandList* list, ID3D12Resource* texture, unsigned parity, bool compare);
+    // Generated frame of a pair with parity `parity`: when the pair is a cut, a predicated copy of `held` (the pair's
+    // first real frame A, in COPY_SOURCE) over `generated` (in COPY_DEST). Nothing is copied otherwise.
+    // late: the generated frame lies after the pair's midpoint. Hard cut: A over every generated frame. Soft (nearest
+    // real): A over the frames up to the midpoint, B (`current`, in COPY_SOURCE too) over the later ones.
+    void holdOnCut(ID3D12GraphicsCommandList* list, ID3D12Resource* generated, ID3D12Resource* held, unsigned parity,
+                   ID3D12Resource* current = nullptr, bool late = false);
+    static constexpr uint64_t kSoftOffset = 1440;   // per parity: hard-or-soft (64-bit), soft-only (64-bit)
+    // Before predicated work in a list: the result buffer in PREDICATION (it already is after record()).
+    void toPredication(ID3D12GraphicsCommandList* list);
+    ID3D12Resource* results() const { return results_.Get(); }
+    // A fixed active area (fractions of the frame; x1 <= x0 = detect the bars), e.g. from the caller's own detection.
+    void setActiveArea(float x0, float y0, float x1, float y1) { params_.areaX0 = x0; params_.areaY0 = y0; params_.areaX1 = x1; params_.areaY1 = y1; }
+    const Params& params() const { return params_; }
+    // Trace (PUSHMPC_CUT_TRACE): the caller reports the fence value that covers the last recorded test.
+    void submitted(ID3D12Fence* fence, uint64_t value);
+    // Cuts held so far (from the readback ring, a few frames after the GPU decided; any thread)
+    uint64_t cuts() const { return cuts_.load(std::memory_order_relaxed); }
+    // With the trace: GPU timestamps around each test (the queue's timestamp frequency; 0 = not timed)
+    void setTimestampFrequency(uint64_t frequency) { tsFrequency_ = frequency; }
+    // The pair's optical flow (EnhanceGraph's NVOF or FidelityFX session; the textures in COPY_SOURCE), copied into the
+    // guard's buffers for its next test. NVOF: S10.5 forward vectors, R8 cost, backward vectors; FidelityFX: integer
+    // forward vectors only. Vectors point from the current frame to the previous one, in flow pixels.
+    void captureFlow(ID3D12GraphicsCommandList* list, ID3D12Resource* forward, ID3D12Resource* cost, ID3D12Resource* backward,
+                     uint32_t gridW, uint32_t gridH, uint32_t flowW, uint32_t flowH, bool fidelity, bool warmingUp);
+    void noFlow() { flowPending_ = 0; }
+    void shutdown();
+    ~CutGuard() { shutdown(); }
+
+private:
+    void loadOverrides();
+    void traceCopy(ID3D12GraphicsCommandList* list);
+    void drainTrace(bool all);
+    Microsoft::WRL::ComPtr<ID3D12Device> device_;
+    Microsoft::WRL::ComPtr<ID3D12RootSignature> root_;
+    Microsoft::WRL::ComPtr<ID3D12PipelineState> pso_;
+    Microsoft::WRL::ComPtr<ID3D12Resource> results_;
+    D3D12_RESOURCE_STATES resultsState_ = D3D12_RESOURCE_STATE_COMMON;
+    std::array<Microsoft::WRL::ComPtr<ID3D12Resource>, 2> inputs_;
+    D3D12_PLACED_SUBRESOURCE_FOOTPRINT footprint_{};
+    uint32_t width_ = 0, height_ = 0;
+    DXGI_FORMAT format_ = DXGI_FORMAT_UNKNOWN;
+    Params params_;
+    std::string who_;
+    // trace readback ring
+    bool trace_ = false;
+    static constexpr uint32_t kTraceSlots = 64, kTraceBytes = 224;
+    Microsoft::WRL::ComPtr<ID3D12Resource> traceBuffer_;
+    struct Pending { uint32_t slot; uint64_t value; ID3D12Fence* fence; };
+    std::deque<Pending> pending_;
+    std::deque<uint32_t> recorded_;    // slots recorded since the last submitted()
+    uint32_t traceNext_ = 0;
+    std::atomic<uint64_t> cuts_{0};
+    struct FlowBuffer { Microsoft::WRL::ComPtr<ID3D12Resource> buffer; D3D12_PLACED_SUBRESOURCE_FOOTPRINT fp{}; D3D12_RESOURCE_STATES state = D3D12_RESOURCE_STATE_COMMON; };
+    bool copyFlow(ID3D12GraphicsCommandList* list, FlowBuffer& b, ID3D12Resource* texture);
+    FlowBuffer flowFwd_, flowCost_, flowBwd_;
+    // Fourier-Mellin (feature 256): its own pipeline (VfgFourierMellin.hlsl) and 7 scratch slabs of 64 x 64 float2
+    Microsoft::WRL::ComPtr<ID3D12RootSignature> fmRoot_;
+    Microsoft::WRL::ComPtr<ID3D12PipelineState> fmPso_;
+    Microsoft::WRL::ComPtr<ID3D12Resource> fmScratch_;
+    void recordFourierMellin(ID3D12GraphicsCommandList* list, ID3D12Resource* previous, ID3D12Resource* current, uint32_t rowPitch);
+    uint32_t flowPending_ = 0;              // for the next test: 1 forward, 2 cost, 4 backward, 8 FidelityFX vectors
+    uint32_t flowGrid_ = 0, flowExtent_ = 0;   // gridW | gridH << 16, flowW | flowH << 16
+    uint64_t tsFrequency_ = 0;
+    Microsoft::WRL::ComPtr<ID3D12QueryHeap> tsHeap_;
+    Microsoft::WRL::ComPtr<ID3D12Resource> tsBuffer_;
+};
+}
