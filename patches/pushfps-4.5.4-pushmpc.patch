+        D3D12_VERSIONED_ROOT_SIGNATURE_DESC fd{}; fd.Version = D3D_ROOT_SIGNATURE_VERSION_1_1; fd.Desc_1_1.NumParameters = 5; fd.Desc_1_1.pParameters = fp;
+        Microsoft::WRL::ComPtr<ID3DBlob> fb, fe;
+        D3D12_HEAP_PROPERTIES sh{}; sh.Type = D3D12_HEAP_TYPE_DEFAULT;
+        D3D12_RESOURCE_DESC sd{}; sd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER; sd.Width = 7 * 64 * 64 * 8; sd.Height = 1; sd.DepthOrArraySize = 1;
+        sd.MipLevels = 1; sd.SampleDesc.Count = 1; sd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR; sd.Flags = D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS;
+        D3D12_COMPUTE_PIPELINE_STATE_DESC pd{};
