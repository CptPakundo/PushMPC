+        params_.adaptiveHistogram16, params_.darkMean, params_.darkMin, params_.darkRatio, params_.darkHistogram, params_.spikeRatio, params_.spikeMin, params_.spikeHistogram, params_.spikeHistogramRatio, params_.warpVeto,
+        params_.warpMin, params_.warpRatio, params_.warpHistogram, params_.holdSad, params_.barLuma, params_.barTaps,
