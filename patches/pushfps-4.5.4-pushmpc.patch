+    parameters[3].ParameterType = D3D12_ROOT_PARAMETER_TYPE_UAV; parameters[3].Descriptor.ShaderRegister = 0;
+    for (int k = 0; k < 3; ++k) { parameters[4 + k].ParameterType = D3D12_ROOT_PARAMETER_TYPE_SRV; parameters[4 + k].Descriptor.ShaderRegister = 2 + k; }   // flow
