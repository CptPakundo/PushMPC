+void CutGuard::loadOverrides() {
+    params_.adaptive = GetEnvironmentVariableW(L"VEYRA_TEST_VFG_FIXED_SHOT_CHANGE", nullptr, 0) == 0;
+    const std::string features = envString(L"PUSHMPC_CUT_FEATURES");
+    if (!features.empty()) params_.features = uint32_t(std::strtoul(features.c_str(), nullptr, 0)) & 511u;
+    trace_ = !envString(L"PUSHMPC_CUT_TRACE").empty();
+    const std::string list = envString(L"PUSHMPC_CUT_PARAMS");
+    size_t pos = 0;
+    std::string applied;
+    while (pos < list.size()) {
+        const size_t end = std::min(list.find_first_of(";,", pos), list.size());
+        const std::string item = list.substr(pos, end - pos);
+        pos = end + 1;
+        const size_t eq = item.find('=');
+        if (eq == std::string::npos) continue;
+        const std::string name = item.substr(0, eq);
+        const float v = float(std::atof(item.c_str() + eq + 1));
+        struct Field { const char* name; float* value; };
+        const Field fields[] = {
+            {"adaptiveMin", &params_.adaptiveMin}, {"adaptiveRatio", &params_.adaptiveRatio}, {"adaptiveHistogram16", &params_.adaptiveHistogram16},
+            {"baselineAttack", &params_.baselineAttack}, {"baselineRelease", &params_.baselineRelease}, {"darkMean", &params_.darkMean},
+            {"darkMin", &params_.darkMin}, {"darkRatio", &params_.darkRatio}, {"darkHistogram", &params_.darkHistogram},
+            {"warpVeto", &params_.warpVeto}, {"warpMin", &params_.warpMin}, {"warpRatio", &params_.warpRatio},
+            {"warpHistogram", &params_.warpHistogram}, {"holdSad", &params_.holdSad}, {"barLuma", &params_.barLuma},
+            {"mcVeto", &params_.mcVeto}, {"mcMin", &params_.mcMin}, {"mcRatio", &params_.mcRatio}, {"barChangeBins", &params_.barChangeBins}, {"barPicture", &params_.barPicture}, {"spikeRatio", &params_.spikeRatio}, {"spikeMin", &params_.spikeMin}, {"spikeHistogram", &params_.spikeHistogram}, {"spikeHistogramRatio", &params_.spikeHistogramRatio}, {"areaX0", &params_.areaX0}, {"areaY0", &params_.areaY0}, {"areaX1", &params_.areaX1}, {"areaY1", &params_.areaY1}, {"scoreThreshold", &params_.scoreThreshold}, {"scoreThresholdFlow", &params_.scoreThresholdFlow}};
+        bool known = false;
+        for (const auto& f : fields) if (name == f.name) { *f.value = v; known = true; }
+        if (name == "barTaps") { params_.barTaps = uint32_t(std::max(0.0f, v)); known = true; }
+        if (name == "barPersist") { params_.barPersist = uint32_t(std::max(1.0f, v)); known = true; }
+        applied += std::format("{}{}={}{}", applied.empty() ? "" : " ", name, v, known ? "" : "(unknown)");
+    }
+    if (!applied.empty()) veyra::log::info("cut-guard", "PUSHMPC_CUT_PARAMS: " + applied);
+}
