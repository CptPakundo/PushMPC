+    if (!check(device->CreateComputePipelineState(&pipeline, IID_PPV_ARGS(&pso_)), "cut-guard pipeline")) { root_.Reset(); return false; }
+    // Fourier-Mellin pipeline (optional: without it the feature is off)
+    if (params_.features & 256u) {
+        std::vector<uint8_t> fm;
+        D3D12_ROOT_PARAMETER1 fp[5]{};
+        fp[0].ParameterType = D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS; fp[0].Constants.Num32BitValues = 12;
+        fp[1].ParameterType = D3D12_ROOT_PARAMETER_TYPE_SRV; fp[1].Descriptor.ShaderRegister = 0;
+        fp[2].ParameterType = D3D12_ROOT_PARAMETER_TYPE_SRV; fp[2].Descriptor.ShaderRegister = 1;
+        fp[3].ParameterType = D3D12_ROOT_PARAMETER_TYPE_UAV; fp[3].Descriptor.ShaderRegister = 0;
+        fp[4].ParameterType = D3D12_ROOT_PARAMETER_TYPE_UAV; fp[4].Descriptor.ShaderRegister = 1;
