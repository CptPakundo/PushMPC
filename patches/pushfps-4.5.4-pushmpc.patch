+    D3D12_HEAP_PROPERTIES heap{}; heap.Type = D3D12_HEAP_TYPE_DEFAULT;
+    D3D12_RESOURCE_DESC buffer{}; buffer.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER; buffer.Width = kResultBytes; buffer.Height = 1;
+    buffer.DepthOrArraySize = 1; buffer.MipLevels = 1; buffer.SampleDesc.Count = 1; buffer.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    buffer.Flags = D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS;
+    if (!check(device->CreateCommittedResource(&heap, D3D12_HEAP_FLAG_NONE, &buffer, D3D12_RESOURCE_STATE_COMMON, nullptr, IID_PPV_ARGS(&results_)), "cut-guard results"))
+        { pso_.Reset(); return false; }
+    resultsState_ = D3D12_RESOURCE_STATE_COMMON;
+    D3D12_RESOURCE_DESC texture{}; texture.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D; texture.Width = width; texture.Height = height;
+    texture.DepthOrArraySize = 1; texture.MipLevels = 1; texture.Format = format; texture.SampleDesc.Count = 1;
+    UINT rows = 0; uint64_t rowBytes = 0, total = 0;
+    device->GetCopyableFootprints(&texture, 0, 1, 0, &footprint_, &rows, &rowBytes, &total);
+    if (ownInputs) {
+        D3D12_RESOURCE_DESC in = buffer; in.Width = uint64_t(footprint_.Footprint.RowPitch) * height; in.Flags = D3D12_RESOURCE_FLAG_NONE;
+        for (auto& b : inputs_)
+            if (!check(device->CreateCommittedResource(&heap, D3D12_HEAP_FLAG_NONE, &in, D3D12_RESOURCE_STATE_COMMON, nullptr, IID_PPV_ARGS(&b)), "cut-guard input"))
+                { shutdown(); return false; }
