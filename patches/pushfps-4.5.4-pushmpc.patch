+void CutGuard::captureAndTest(ID3D12GraphicsCommandList* list, ID3D12Resource* texture, unsigned parity, bool compare) {
+    if (!ready() || !list || !texture || !inputs_[0] || !inputs_[1]) return;
+    parity &= 1u;
+    auto* current = inputs_[parity].Get();
+    auto* previous = inputs_[1 - parity].Get();
+    D3D12_RESOURCE_BARRIER b[2]{};
+    transition(b[0], current, D3D12_RESOURCE_STATE_COMMON, D3D12_RESOURCE_STATE_COPY_DEST);
+    list->ResourceBarrier(1, b);
+    D3D12_TEXTURE_COPY_LOCATION src{}; src.pResource = texture; src.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    D3D12_TEXTURE_COPY_LOCATION dst{}; dst.pResource = current; dst.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT; dst.PlacedFootprint = footprint_;
+    list->CopyTextureRegion(&dst, 0, 0, 0, &src, nullptr);
+    transition(b[0], current, D3D12_RESOURCE_STATE_COPY_DEST, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+    transition(b[1], previous, D3D12_RESOURCE_STATE_COMMON, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+    list->ResourceBarrier(2, b);
+    record(list, previous, current, footprint_.Footprint.RowPitch, parity, compare);
+    transition(b[0], current, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE, D3D12_RESOURCE_STATE_COMMON);
+    transition(b[1], previous, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE, D3D12_RESOURCE_STATE_COMMON);
+    list->ResourceBarrier(2, b);
+}
+
+// Fourier-Mellin (VfgFourierMellin.hlsl): 2 x FFT 64x64, log-polar, FFT, cross-power, inverse FFT, peak (scale,
+// rotation); A warped, FFT, cross-power with B, inverse FFT, peak (translation). 19 small dispatches with UAV barriers.
+void CutGuard::recordFourierMellin(ID3D12GraphicsCommandList* list, ID3D12Resource* previous, ID3D12Resource* current, uint32_t rowPitch) {
+    list->SetComputeRootSignature(fmRoot_.Get());
+    list->SetPipelineState(fmPso_.Get());
+    list->SetComputeRootShaderResourceView(1, previous->GetGPUVirtualAddress());
+    list->SetComputeRootShaderResourceView(2, current->GetGPUVirtualAddress());
+    list->SetComputeRootUnorderedAccessView(3, fmScratch_->GetGPUVirtualAddress());
+    list->SetComputeRootUnorderedAccessView(4, results_->GetGPUVirtualAddress());
+    uint32_t area0 = 0, area1 = 0;
+    if (params_.areaX1 > params_.areaX0 && params_.areaY1 > params_.areaY0) {
+        area0 = uint32_t(std::clamp(params_.areaX0, 0.0f, 1.0f) * width_) | (uint32_t(std::clamp(params_.areaX1, 0.0f, 1.0f) * width_) << 16);
+        area1 = uint32_t(std::clamp(params_.areaY0, 0.0f, 1.0f) * height_) | (uint32_t(std::clamp(params_.areaY1, 0.0f, 1.0f) * height_) << 16);
+    }
+    D3D12_RESOURCE_BARRIER uav[2]{};
+    uav[0].Type = D3D12_RESOURCE_BARRIER_TYPE_UAV; uav[0].UAV.pResource = fmScratch_.Get();
+    uav[1].Type = D3D12_RESOURCE_BARRIER_TYPE_UAV; uav[1].UAV.pResource = results_.Get();
+    auto run = [&](uint32_t mode, uint32_t groups, uint32_t slabA = 0, uint32_t slabB = 0, uint32_t slabOut = 0, uint32_t inverse = 0, uint32_t which = 0) {
+        const uint32_t k[12] = {mode, width_, height_, rowPitch, format_ == DXGI_FORMAT_R10G10B10A2_UNORM ? 1u : 0u, slabA, slabB, slabOut, inverse, which, area0, area1};
+        list->SetComputeRoot32BitConstants(0, 12, k, 0);
+        list->Dispatch(groups, 1, 1);
+        list->ResourceBarrier(2, uav);
+    };
+    auto fft = [&](uint32_t slab, uint32_t count, uint32_t inverse) { run(1, 64 * count, slab, 0, 0, inverse); run(2, 64 * count, slab, 0, 0, inverse); };
+    run(0, 128);                    // both frames, windowed -> slabs 0 / 1
+    fft(0, 2, 0);
+    run(3, 128);                    // log-polar log-magnitudes -> slabs 2 / 3
+    fft(2, 2, 0);
+    run(4, 64, 2, 3, 4);            // cross-power -> slab 4
+    fft(4, 1, 1);
+    run(5, 1, 4, 0, 0, 0, 0);       // scale, rotation, peak
+    run(6, 64);                     // A warped -> slab 5
+    fft(5, 1, 0);
+    run(4, 64, 5, 1, 6);            // cross-power with B's spectrum -> slab 6
+    fft(6, 1, 1);
+    run(5, 1, 6, 0, 0, 0, 1);       // translation, peak
+}
+
+bool CutGuard::copyFlow(ID3D12GraphicsCommandList* list, FlowBuffer& b, ID3D12Resource* texture) {
+    if (!texture) return false;
+    const D3D12_RESOURCE_DESC td = texture->GetDesc();
+    D3D12_PLACED_SUBRESOURCE_FOOTPRINT fp{}; UINT rows = 0; UINT64 rowBytes = 0, total = 0;
+    device_->GetCopyableFootprints(&td, 0, 1, 0, &fp, &rows, &rowBytes, &total);
+    if (!b.buffer || b.fp.Footprint.Width != fp.Footprint.Width || b.fp.Footprint.Height != fp.Footprint.Height || b.fp.Footprint.Format != fp.Footprint.Format) {
+        b.buffer.Reset();
+        D3D12_HEAP_PROPERTIES heap{}; heap.Type = D3D12_HEAP_TYPE_DEFAULT;
+        D3D12_RESOURCE_DESC bd{}; bd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER; bd.Width = total; bd.Height = 1; bd.DepthOrArraySize = 1;
+        bd.MipLevels = 1; bd.SampleDesc.Count = 1; bd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+        if (!check(device_->CreateCommittedResource(&heap, D3D12_HEAP_FLAG_NONE, &bd, D3D12_RESOURCE_STATE_COMMON, nullptr, IID_PPV_ARGS(&b.buffer)), "cut-guard flow buffer")) return false;
+        b.fp = fp; b.state = D3D12_RESOURCE_STATE_COMMON;
+    }
+    D3D12_RESOURCE_BARRIER barrier{};
+    if (b.state != D3D12_RESOURCE_STATE_COPY_DEST) { transition(barrier, b.buffer.Get(), b.state, D3D12_RESOURCE_STATE_COPY_DEST); list->ResourceBarrier(1, &barrier); }
+    D3D12_TEXTURE_COPY_LOCATION src{}; src.pResource = texture; src.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    D3D12_TEXTURE_COPY_LOCATION dst{}; dst.pResource = b.buffer.Get(); dst.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT; dst.PlacedFootprint = b.fp;
+    list->CopyTextureRegion(&dst, 0, 0, 0, &src, nullptr);
+    transition(barrier, b.buffer.Get(), D3D12_RESOURCE_STATE_COPY_DEST, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+    list->ResourceBarrier(1, &barrier);
+    b.state = D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE;
+    return true;
+}
+
+void CutGuard::captureFlow(ID3D12GraphicsCommandList* list, ID3D12Resource* forward, ID3D12Resource* cost, ID3D12Resource* backward,
+                           uint32_t gridW, uint32_t gridH, uint32_t flowW, uint32_t flowH, bool fidelity, bool warmingUp) {
+    flowPending_ = 0;
+    if (!ready() || !list || !forward || warmingUp || !(params_.features & 128u)) return;
+    if (!copyFlow(list, flowFwd_, forward)) return;
+    uint32_t f = 1u | (fidelity ? 8u : 0u);
+    if (!fidelity && cost && copyFlow(list, flowCost_, cost)) f |= 2u;
+    if (!fidelity && backward && copyFlow(list, flowBwd_, backward)) f |= 4u;
+    flowGrid_ = gridW | (gridH << 16); flowExtent_ = flowW | (flowH << 16);
+    flowPending_ = f;
+}
+
+void CutGuard::toPredication(ID3D12GraphicsCommandList* list) {
+    if (!results_ || resultsState_ == D3D12_RESOURCE_STATE_PREDICATION) return;
+    D3D12_RESOURCE_BARRIER barrier{};
+    transition(barrier, results_.Get(), resultsState_, D3D12_RESOURCE_STATE_PREDICATION);
+    list->ResourceBarrier(1, &barrier);
+    resultsState_ = D3D12_RESOURCE_STATE_PREDICATION;
+}
+
+void CutGuard::holdOnCut(ID3D12GraphicsCommandList* list, ID3D12Resource* generated, ID3D12Resource* held, unsigned parity,
+                         ID3D12Resource* current, bool late) {
+    if (!ready() || !list || !generated || !held) return;
+    toPredication(list);
+    // up to the midpoint: A on a hard or soft cut; after it: A on a hard cut, B on a soft one
+    const uint64_t soft = kSoftOffset + (parity & 1u) * 16;
+    list->SetPredication(results_.Get(), late ? (parity & 1u) * 8 : soft, D3D12_PREDICATION_OP_EQUAL_ZERO);   // skipped unless held
+    list->CopyResource(generated, held);
+    if (late && current) {
+        list->SetPredication(results_.Get(), soft + 8, D3D12_PREDICATION_OP_EQUAL_ZERO);   // skipped unless soft
+        list->CopyResource(generated, current);
+    }
+    list->SetPredication(nullptr, 0, D3D12_PREDICATION_OP_EQUAL_ZERO);
+}
+
+void CutGuard::traceCopy(ID3D12GraphicsCommandList* list) {
+    if (!traceBuffer_) return;
+    D3D12_RESOURCE_BARRIER barrier{};
+    transition(barrier, results_.Get(), resultsState_, D3D12_RESOURCE_STATE_COPY_SOURCE);
+    list->ResourceBarrier(1, &barrier);
+    const uint32_t slot = traceNext_++ % kTraceSlots;
+    list->CopyBufferRegion(traceBuffer_.Get(), uint64_t(slot) * kTraceBytes, results_.Get(), kTraceOffset, kTraceBytes);
+    resultsState_ = D3D12_RESOURCE_STATE_COPY_SOURCE;
+    recorded_.push_back(slot);
+    if (recorded_.size() > kTraceSlots / 2) recorded_.pop_front();   // never reported as submitted: dropped
+}
+
+void CutGuard::submitted(ID3D12Fence* fence, uint64_t value) {
+    if (!traceBuffer_ || !fence) { recorded_.clear(); return; }
+    for (const uint32_t slot : recorded_) pending_.push_back({slot, value, fence});
+    recorded_.clear();
+    while (pending_.size() > kTraceSlots - 4) pending_.pop_front();
+    drainTrace(false);
+}
+
+void CutGuard::drainTrace(bool all) {
+    if (!traceBuffer_) return;
+    while (!pending_.empty()) {
+        const Pending p = pending_.front();
+        if (p.fence->GetCompletedValue() < p.value) {
+            if (!all) break;
+            HANDLE e = CreateEventW(nullptr, FALSE, FALSE, nullptr);
+            if (!e) break;
+            p.fence->SetEventOnCompletion(p.value, e);
+            WaitForSingleObject(e, 2000);
+            CloseHandle(e);
+            if (p.fence->GetCompletedValue() < p.value) break;
+        }
+        pending_.pop_front();
+        const D3D12_RANGE range{size_t(p.slot) * kTraceBytes, size_t(p.slot + 1) * kTraceBytes};
+        uint8_t* mapped = nullptr;
+        if (FAILED(traceBuffer_->Map(0, &range, reinterpret_cast<void**>(&mapped))) || !mapped) continue;
+        uint32_t u[56]{};
+        std::memcpy(u, mapped + range.Begin, sizeof(u));
+        const D3D12_RANGE none{0, 0};
+        traceBuffer_->Unmap(0, &none);
+        if (u[1] != 0 && u[21] != 0) cuts_.fetch_add(1, std::memory_order_relaxed);
+        if (!trace_) continue;
+        double gpuUs = -1.0;
+        if (tsBuffer_ && tsFrequency_) {
+            const D3D12_RANGE tr{size_t(p.slot) * 16, size_t(p.slot + 1) * 16};
+            uint8_t* tm = nullptr;
+            if (SUCCEEDED(tsBuffer_->Map(0, &tr, reinterpret_cast<void**>(&tm))) && tm) {
+                uint64_t ts[2]{}; std::memcpy(ts, tm + tr.Begin, sizeof(ts));
+                const D3D12_RANGE nothing{0, 0}; tsBuffer_->Unmap(0, &nothing);
+                if (ts[1] > ts[0]) gpuUs = double(ts[1] - ts[0]) * 1e6 / double(tsFrequency_);
+            }
+        }
+        auto f = [&](int i) { float v; std::memcpy(&v, &u[i], 4); return v; };
+        const uint32_t rules = u[20];
+        veyra::log::info("cut-guard", std::format(
+            "trace {} pair={} compare={} cut={} sad={:.4f} hist={:.4f} hist16={:.4f} histN16={:.4f} mrSad={:.4f} mrSadN={:.3f} mrSadW={:.4f} box={:.4f} "
+            "warpRatio={:.3f} base={:.4f} baseN={:.3f} baseW={:.4f} thr={:.4f} meanA={:.3f} meanB={:.3f} sigA={:.3f} sigB={:.3f} "
+            "warp=({:.3f},{:.1f},{:.3f},{:.1f}) mcSad={:.4f} mcRatio={:.3f} baseMc={:.4f} barsA={:08X} barsB={:08X} zoomRes={:.4f} zoomRes0={:.4f} zS={:.3f} zTx={:.2f} zTy={:.2f} chroma={:.4f} edge={:.4f} edgeE={:.3f} devB={:.4f} devA={:.4f} lmFrac={:.3f} lmQ25={:.3f} lmTex={} gpuUs={:.1f} score={:.2f} flowRes={:.4f} flowLap={:.3f} flowFb={:.3f} flowCost={:.3f} flowCostHi={:.3f} flowFlags={} fmRes={:.4f} fmPeak={:.3f} fmPeakT={:.3f} fmLnS={:.3f} rules={}{}{}{}{}{}{}{}{}{}{}{}{}{}{}{}{} rect={}-{}x{}-{}",
+            who_, u[0], u[1], u[21], f(2), f(3), f(4), f(5), f(6), f(7), f(8), f(24), f(25), f(9), f(10), f(11), f(26), f(12), f(13), f(14), f(15),
+            f(16), f(17), f(18), f(19), f(28), f(29), f(30), u[27], u[31], f(32), f(33), f(34), f(35), f(36), f(37), f(38), f(39), f(40), f(41), f(42), f(43), u[44], gpuUs, f(45), f(46), f(47), f(48), f(49), f(50), u[51], f(52), f(53), f(54), f(55), rules & 1 ? "F" : "-", rules & 2 ? "A" : "-", rules & 4 ? "D" : "-", rules & 8 ? "W" : "-",
+            rules & 16 ? "V" : "-", rules & 32 ? "L" : "-", rules & 64 ? "H" : "-", rules & 128 ? "k" : "-", rules & 256 ? "m" : "-", rules & 512 ? "S" : "-", rules & 1024 ? "B" : "-", rules & 2048 ? "M" : "-", rules & 4096 ? "v" : "-", rules & 8192 ? "c" : "-", rules & 16384 ? "Z" : "-", rules & 32768 ? "X" : "-", rules & 65536 ? "N" : "-",
+            u[22] & 0xFFFF, u[22] >> 16, u[23] & 0xFFFF, u[23] >> 16));
+    }
+}
+
+void CutGuard::shutdown() {
+    if (traceBuffer_) drainTrace(true);
+    pending_.clear(); recorded_.clear();
+    traceBuffer_.Reset(); tsBuffer_.Reset(); tsHeap_.Reset();
+    flowFwd_ = {}; flowCost_ = {}; flowBwd_ = {}; flowPending_ = 0;
+    fmPso_.Reset(); fmRoot_.Reset(); fmScratch_.Reset();
+    for (auto& b : inputs_) b.Reset();
+    results_.Reset(); pso_.Reset(); root_.Reset(); device_.Reset();
+    resultsState_ = D3D12_RESOURCE_STATE_COMMON;
+}
