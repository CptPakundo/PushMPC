+        D3D12_HEAP_PROPERTIES rb{}; rb.Type = D3D12_HEAP_TYPE_READBACK;
+        D3D12_RESOURCE_DESC t = buffer; t.Width = uint64_t(kTraceSlots) * kTraceBytes; t.Flags = D3D12_RESOURCE_FLAG_NONE;
+        if (!check(device->CreateCommittedResource(&rb, D3D12_HEAP_FLAG_NONE, &t, D3D12_RESOURCE_STATE_COPY_DEST, nullptr, IID_PPV_ARGS(&traceBuffer_)), "cut-guard readback"))
