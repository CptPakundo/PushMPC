+// SPDX-License-Identifier: GPL-3.0-only
+// PushMPC (local addition, not upstream): the scene-cut guard for every frame-generation backend.
+// See include/veyra/pipeline/PushMpcCutGuard.h and shaders/VfgShotChange.hlsl.
+#include "veyra/pipeline/PushMpcCutGuard.h"
+#include "veyra/pipeline/GpuPassUtils.h"
+#include "veyra/core/SceneCadenceAnalyzer.h"
+#include "veyra/Log.h"
+#include <Windows.h>
+#include <algorithm>
+#include <cstring>
+#include <format>
+#include <string>
+#include <vector>
+
+namespace veyra::pipeline {
+namespace {
+constexpr unsigned kConstants = 50;   // VfgShotChange.hlsl cbuffer
+constexpr uint32_t kTraceOffset = 928;
+void transition(D3D12_RESOURCE_BARRIER& barrier, ID3D12Resource* resource, D3D12_RESOURCE_STATES from, D3D12_RESOURCE_STATES to) {
+    barrier = {}; barrier.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    barrier.Transition = {resource, D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES, from, to};
+}
+bool check(HRESULT value, const char* what) {
+    if (SUCCEEDED(value)) return true;
+    veyra::log::error("cut-guard", std::format("{} failed hr=0x{:08X}", what, unsigned(value)));
+    return false;
+}
+std::string envString(const wchar_t* name) {
+    wchar_t buffer[2048]{};
+    const DWORD n = GetEnvironmentVariableW(name, buffer, 2048);
+    if (!n || n >= 2048) return {};
+    std::string out;
+    for (DWORD i = 0; i < n; ++i) out.push_back(buffer[i] < 128 ? char(buffer[i]) : '?');
+    return out;
+}
+}  // namespace
