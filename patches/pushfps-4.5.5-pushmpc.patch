+    const std::string features = envString(L"PUSHMPC_CUT_FEATURES");
+    if (!features.empty()) params_.features = uint32_t(std::strtoul(features.c_str(), nullptr, 0)) & 511u;
+    trace_ = !envString(L"PUSHMPC_CUT_TRACE").empty();
+    const std::string list = envString(L"PUSHMPC_CUT_PARAMS");
+    size_t pos = 0;
+    std::string applied;
+    while (pos < list.size()) {
+        const size_t end = std::min(list.find_first_of(";,", pos), list.size());
+        const std::string item = list.substr(pos, end - pos);
+        pos = end + 1;
+        const size_t eq = item.find('=');
+        if (eq == std::string::npos) continue;
+        const std::string name = item.substr(0, eq);
+        const float v = float(std::atof(item.c_str() + eq + 1));
+        struct Field { const char* name; float* value; };
+        const Field fields[] = {
+            {"adaptiveMin", &params_.adaptiveMin}, {"adaptiveRatio", &params_.adaptiveRatio}, {"adaptiveHistogram16", &params_.adaptiveHistogram16},
+            {"baselineAttack", &params_.baselineAttack}, {"baselineRelease", &params_.baselineRelease}, {"darkMean", &params_.darkMean},
+            {"darkMin", &params_.darkMin}, {"darkRatio", &params_.darkRatio}, {"darkHistogram", &params_.darkHistogram},
+            {"warpVeto", &params_.warpVeto}, {"warpMin", &params_.warpMin}, {"warpRatio", &params_.warpRatio},
+            {"warpHistogram", &params_.warpHistogram}, {"holdSad", &params_.holdSad}, {"barLuma", &params_.barLuma},
+            {"mcVeto", &params_.mcVeto}, {"mcMin", &params_.mcMin}, {"mcRatio", &params_.mcRatio}, {"barChangeBins", &params_.barChangeBins}, {"barPicture", &params_.barPicture}, {"spikeRatio", &params_.spikeRatio}, {"spikeMin", &params_.spikeMin}, {"spikeHistogram", &params_.spikeHistogram}, {"spikeHistogramRatio", &params_.spikeHistogramRatio}, {"areaX0", &params_.areaX0}, {"areaY0", &params_.areaY0}, {"areaX1", &params_.areaX1}, {"areaY1", &params_.areaY1}, {"scoreThreshold", &params_.scoreThreshold}, {"scoreThresholdFlow", &params_.scoreThresholdFlow}};
+        bool known = false;
+        for (const auto& f : fields) if (name == f.name) { *f.value = v; known = true; }
+        if (name == "barTaps") { params_.barTaps = uint32_t(std::max(0.0f, v)); known = true; }
+        if (name == "barPersist") { params_.barPersist = uint32_t(std::max(1.0f, v)); known = true; }
+        applied += std::format("{}{}={}{}", applied.empty() ? "" : " ", name, v, known ? "" : "(unknown)");
+    }
+    if (!applied.empty()) veyra::log::info("cut-guard", "PUSHMPC_CUT_PARAMS: " + applied);
+}
+
+bool CutGuard::initialize(ID3D12Device* device, uint32_t width, uint32_t height, DXGI_FORMAT format, bool ownInputs, const char* who) {
+    shutdown();
+    if (!device || !width || !height) return false;
+    device_ = device; width_ = width; height_ = height; format_ = format; who_ = who ? who : "";
+    loadOverrides();
+    std::vector<uint8_t> cs;
+    if (!loadShaderBytes("VfgShotChange.dxil", cs)) return false;
+    D3D12_ROOT_PARAMETER1 parameters[7]{};
+    parameters[0].ParameterType = D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS; parameters[0].Constants.Num32BitValues = kConstants;
+    parameters[1].ParameterType = D3D12_ROOT_PARAMETER_TYPE_SRV; parameters[1].Descriptor.ShaderRegister = 0;
+    parameters[2].ParameterType = D3D12_ROOT_PARAMETER_TYPE_SRV; parameters[2].Descriptor.ShaderRegister = 1;
+    parameters[3].ParameterType = D3D12_ROOT_PARAMETER_TYPE_UAV; parameters[3].Descriptor.ShaderRegister = 0;
+    for (int k = 0; k < 3; ++k) { parameters[4 + k].ParameterType = D3D12_ROOT_PARAMETER_TYPE_SRV; parameters[4 + k].Descriptor.ShaderRegister = 2 + k; }   // flow
+    for (auto& parameter : parameters) parameter.ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
+    D3D12_VERSIONED_ROOT_SIGNATURE_DESC desc{}; desc.Version = D3D_ROOT_SIGNATURE_VERSION_1_1;
+    desc.Desc_1_1.NumParameters = 7; desc.Desc_1_1.pParameters = parameters;
+    Microsoft::WRL::ComPtr<ID3DBlob> blob, error;
+    if (!check(D3D12SerializeVersionedRootSignature(&desc, &blob, &error), "serialize cut-guard root signature") ||
+        !check(device->CreateRootSignature(0, blob->GetBufferPointer(), blob->GetBufferSize(), IID_PPV_ARGS(&root_)), "cut-guard root signature"))
+        return false;
+    D3D12_COMPUTE_PIPELINE_STATE_DESC pipeline{}; pipeline.pRootSignature = root_.Get(); pipeline.CS = {cs.data(), cs.size()};
+    if (!check(device->CreateComputePipelineState(&pipeline, IID_PPV_ARGS(&pso_)), "cut-guard pipeline")) { root_.Reset(); return false; }
+    // Fourier-Mellin pipeline (optional: without it the feature is off)
+    if (params_.features & 256u) {
+        std::vector<uint8_t> fm;
+        D3D12_ROOT_PARAMETER1 fp[5]{};
+        fp[0].ParameterType = D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS; fp[0].Constants.Num32BitValues = 12;
+        fp[1].ParameterType = D3D12_ROOT_PARAMETER_TYPE_SRV; fp[1].Descriptor.ShaderRegister = 0;
+        fp[2].ParameterType = D3D12_ROOT_PARAMETER_TYPE_SRV; fp[2].Descriptor.ShaderRegister = 1;
+        fp[3].ParameterType = D3D12_ROOT_PARAMETER_TYPE_UAV; fp[3].Descriptor.ShaderRegister = 0;
+        fp[4].ParameterType = D3D12_ROOT_PARAMETER_TYPE_UAV; fp[4].Descriptor.ShaderRegister = 1;
+        for (auto& p : fp) p.ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
+        D3D12_VERSIONED_ROOT_SIGNATURE_DESC fd{}; fd.Version = D3D_ROOT_SIGNATURE_VERSION_1_1; fd.Desc_1_1.NumParameters = 5; fd.Desc_1_1.pParameters = fp;
+        Microsoft::WRL::ComPtr<ID3DBlob> fb, fe;
+        D3D12_HEAP_PROPERTIES sh{}; sh.Type = D3D12_HEAP_TYPE_DEFAULT;
+        D3D12_RESOURCE_DESC sd{}; sd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER; sd.Width = 7 * 64 * 64 * 8; sd.Height = 1; sd.DepthOrArraySize = 1;
+        sd.MipLevels = 1; sd.SampleDesc.Count = 1; sd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR; sd.Flags = D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS;
+        D3D12_COMPUTE_PIPELINE_STATE_DESC pd{};
+        bool ok = loadShaderBytes("VfgFourierMellin.dxil", fm) && SUCCEEDED(D3D12SerializeVersionedRootSignature(&fd, &fb, &fe)) &&
+                  SUCCEEDED(device->CreateRootSignature(0, fb->GetBufferPointer(), fb->GetBufferSize(), IID_PPV_ARGS(&fmRoot_)));
+        if (ok) { pd.pRootSignature = fmRoot_.Get(); pd.CS = {fm.data(), fm.size()}; ok = SUCCEEDED(device->CreateComputePipelineState(&pd, IID_PPV_ARGS(&fmPso_))); }
+        if (ok) ok = SUCCEEDED(device->CreateCommittedResource(&sh, D3D12_HEAP_FLAG_NONE, &sd, D3D12_RESOURCE_STATE_UNORDERED_ACCESS, nullptr, IID_PPV_ARGS(&fmScratch_)));
+        if (!ok) { fmPso_.Reset(); fmRoot_.Reset(); fmScratch_.Reset(); params_.features &= ~256u; veyra::log::warn("cut-guard", "Fourier-Mellin pipeline unavailable: off"); }
+    }
+    D3D12_HEAP_PROPERTIES heap{}; heap.Type = D3D12_HEAP_TYPE_DEFAULT;
+    D3D12_RESOURCE_DESC buffer{}; buffer.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER; buffer.Width = kResultBytes; buffer.Height = 1;
+    buffer.DepthOrArraySize = 1; buffer.MipLevels = 1; buffer.SampleDesc.Count = 1; buffer.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    buffer.Flags = D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS;
+    if (!check(device->CreateCommittedResource(&heap, D3D12_HEAP_FLAG_NONE, &buffer, D3D12_RESOURCE_STATE_COMMON, nullptr, IID_PPV_ARGS(&results_)), "cut-guard results"))
+        { pso_.Reset(); return false; }
+    resultsState_ = D3D12_RESOURCE_STATE_COMMON;
+    D3D12_RESOURCE_DESC texture{}; texture.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D; texture.Width = width; texture.Height = height;
+    texture.DepthOrArraySize = 1; texture.MipLevels = 1; texture.Format = format; texture.SampleDesc.Count = 1;
+    UINT rows = 0; uint64_t rowBytes = 0, total = 0;
+    device->GetCopyableFootprints(&texture, 0, 1, 0, &footprint_, &rows, &rowBytes, &total);
+    if (ownInputs) {
+        D3D12_RESOURCE_DESC in = buffer; in.Width = uint64_t(footprint_.Footprint.RowPitch) * height; in.Flags = D3D12_RESOURCE_FLAG_NONE;
+        for (auto& b : inputs_)
+            if (!check(device->CreateCommittedResource(&heap, D3D12_HEAP_FLAG_NONE, &in, D3D12_RESOURCE_STATE_COMMON, nullptr, IID_PPV_ARGS(&b)), "cut-guard input"))
+                { shutdown(); return false; }
+    }
+    {   // the readback ring: always (the cut count for the caller, e.g. PushMPC's SDR to HDR limiter); logged with the trace
+        D3D12_HEAP_PROPERTIES rb{}; rb.Type = D3D12_HEAP_TYPE_READBACK;
+        D3D12_RESOURCE_DESC t = buffer; t.Width = uint64_t(kTraceSlots) * kTraceBytes; t.Flags = D3D12_RESOURCE_FLAG_NONE;
+        if (!check(device->CreateCommittedResource(&rb, D3D12_HEAP_FLAG_NONE, &t, D3D12_RESOURCE_STATE_COPY_DEST, nullptr, IID_PPV_ARGS(&traceBuffer_)), "cut-guard readback"))
+            { trace_ = false; traceBuffer_.Reset(); }
+        if (trace_) {   // timestamps per slot (begin, end), resolved next to the trace record
+            D3D12_QUERY_HEAP_DESC qd{}; qd.Type = D3D12_QUERY_HEAP_TYPE_TIMESTAMP; qd.Count = kTraceSlots * 2;
+            D3D12_RESOURCE_DESC tb = t; tb.Width = uint64_t(kTraceSlots) * 16;
+            if (FAILED(device->CreateQueryHeap(&qd, IID_PPV_ARGS(&tsHeap_))) ||
+                FAILED(device->CreateCommittedResource(&rb, D3D12_HEAP_FLAG_NONE, &tb, D3D12_RESOURCE_STATE_COPY_DEST, nullptr, IID_PPV_ARGS(&tsBuffer_))))
+                { tsHeap_.Reset(); tsBuffer_.Reset(); }
+        }
+    }
+    veyra::log::info("cut-guard", std::format("{}: {}x{} format {} own inputs {} features {} adaptive {} thresholds adaptive {}/{}/{} dark {}/{}/{}/{} spike {}/{}/{}/{} warp {}/{}/{}/{} hold {} bars {}/{}{}",
+        who_, width, height, unsigned(format), ownInputs, params_.features, params_.adaptive, params_.adaptiveMin, params_.adaptiveRatio,
+        params_.adaptiveHistogram16, params_.darkMean, params_.darkMin, params_.darkRatio, params_.darkHistogram, params_.spikeRatio, params_.spikeMin, params_.spikeHistogram, params_.spikeHistogramRatio, params_.warpVeto,
+        params_.warpMin, params_.warpRatio, params_.warpHistogram, params_.holdSad, params_.barLuma, params_.barTaps,
+        trace_ ? " trace" : ""));
+    return true;
+}
+
+void CutGuard::record(ID3D12GraphicsCommandList* list, ID3D12Resource* previous, ID3D12Resource* current, uint32_t rowPitch,
+                      unsigned parity, bool compare) {
+    if (!ready() || !list) return;
+    drainTrace(false);
+    D3D12_RESOURCE_BARRIER barrier{};
+    if (resultsState_ != D3D12_RESOURCE_STATE_UNORDERED_ACCESS) {
+        transition(barrier, results_.Get(), resultsState_, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+        list->ResourceBarrier(1, &barrier);
+    }
+    const core::SceneCadenceAnalyzer::Config scene{};
+    std::array<uint32_t, kConstants> c{};
+    c[0] = width_; c[1] = height_; c[2] = rowPitch; c[3] = format_ == DXGI_FORMAT_R10G10B10A2_UNORM ? 1u : 0u; c[4] = parity & 1u; c[5] = compare ? 1u : 0u;
+    const float f[] = {float(scene.sceneCutSadThreshold), float(scene.sceneCutHistogramThreshold), float(scene.replacementSadThreshold),
+                       float(scene.replacementHistogramThreshold), float(scene.flashSadThreshold), float(scene.flashHistogramThreshold),
+                       params_.adaptive ? params_.adaptiveMin : 0.0f, params_.adaptiveRatio, params_.adaptiveHistogram16, params_.baselineAttack,
+                       params_.baselineRelease, params_.darkMean, params_.darkMin, params_.darkRatio, params_.darkHistogram, params_.warpVeto,
+                       params_.warpMin, params_.warpRatio, params_.warpHistogram, params_.holdSad, params_.barLuma};
+    std::memcpy(c.data() + 6, f, sizeof(f));   // 6..26
+    c[27] = params_.barTaps;
+    c[28] = params_.adaptive ? params_.features : 0u;
+    const float area[] = {params_.areaX0, params_.areaY0, params_.areaX1, params_.areaY1};
+    std::memcpy(c.data() + 29, area, sizeof(area));
+    const float spike[] = {params_.spikeRatio, params_.spikeMin, params_.spikeHistogram, params_.spikeHistogramRatio};
+    std::memcpy(c.data() + 33, spike, sizeof(spike));
+    const float more[] = {params_.mcVeto, params_.mcMin, params_.mcRatio, params_.barChangeBins, params_.barPicture};
+    std::memcpy(c.data() + 37, more, sizeof(more));
+    c[42] = params_.barPersist;
+    std::memcpy(c.data() + 43, &params_.scoreThreshold, sizeof(float));
+    const uint32_t flow = (params_.features & 128u) ? flowPending_ : 0u;
+    std::memcpy(c.data() + 49, &params_.scoreThresholdFlow, sizeof(float));
+    c[44] = flow; c[45] = flowFwd_.fp.Footprint.RowPitch; c[46] = flowCost_.fp.Footprint.RowPitch; c[47] = flowGrid_; c[48] = flowExtent_;
+    const uint32_t tsSlot = traceNext_ % kTraceSlots;
+    const bool timed = trace_ && tsHeap_ && tsBuffer_;
+    if (timed) list->EndQuery(tsHeap_.Get(), D3D12_QUERY_TYPE_TIMESTAMP, tsSlot * 2);
+    // Fourier-Mellin only where NVOF's measures are missing (it added nothing beside them in the calibration)
+    const bool fmRun = (params_.features & 256u) && fmPso_ && compare && !((params_.features & 128u) && (flowPending_ & 6u) == 6u);
+    if (fmRun) recordFourierMellin(list, previous, current, rowPitch);
+    list->SetComputeRootSignature(root_.Get());
+    list->SetPipelineState(pso_.Get());
+    list->SetComputeRoot32BitConstants(0, kConstants, c.data(), 0);
+    list->SetComputeRootShaderResourceView(1, previous->GetGPUVirtualAddress());
+    list->SetComputeRootShaderResourceView(2, current->GetGPUVirtualAddress());
+    list->SetComputeRootUnorderedAccessView(3, results_->GetGPUVirtualAddress());
+    // the flow buffers (unused ones point at the previous frame, which is already a shader resource here)
+    list->SetComputeRootShaderResourceView(4, (flow & 1u) && flowFwd_.buffer ? flowFwd_.buffer->GetGPUVirtualAddress() : previous->GetGPUVirtualAddress());
+    list->SetComputeRootShaderResourceView(5, (flow & 2u) && flowCost_.buffer ? flowCost_.buffer->GetGPUVirtualAddress() : previous->GetGPUVirtualAddress());
+    list->SetComputeRootShaderResourceView(6, (flow & 4u) && flowBwd_.buffer ? flowBwd_.buffer->GetGPUVirtualAddress() : previous->GetGPUVirtualAddress());
+    flowPending_ = 0;
+    list->Dispatch(1, 1, 1);
+    if (timed) {
+        list->EndQuery(tsHeap_.Get(), D3D12_QUERY_TYPE_TIMESTAMP, tsSlot * 2 + 1);
+        list->ResolveQueryData(tsHeap_.Get(), D3D12_QUERY_TYPE_TIMESTAMP, tsSlot * 2, 2, tsBuffer_.Get(), uint64_t(tsSlot) * 16);
+    }
+    D3D12_RESOURCE_BARRIER uav{}; uav.Type = D3D12_RESOURCE_BARRIER_TYPE_UAV; uav.UAV.pResource = results_.Get();
+    list->ResourceBarrier(1, &uav);
+    resultsState_ = D3D12_RESOURCE_STATE_UNORDERED_ACCESS;
+    traceCopy(list);
+    toPredication(list);
+}
+
+void CutGuard::captureAndTest(ID3D12GraphicsCommandList* list, ID3D12Resource* texture, unsigned parity, bool compare) {
+    if (!ready() || !list || !texture || !inputs_[0] || !inputs_[1]) return;
+    parity &= 1u;
+    auto* current = inputs_[parity].Get();
+    auto* previous = inputs_[1 - parity].Get();
+    D3D12_RESOURCE_BARRIER b[2]{};
+    transition(b[0], current, D3D12_RESOURCE_STATE_COMMON, D3D12_RESOURCE_STATE_COPY_DEST);
+    list->ResourceBarrier(1, b);
+    D3D12_TEXTURE_COPY_LOCATION src{}; src.pResource = texture; src.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    D3D12_TEXTURE_COPY_LOCATION dst{}; dst.pResource = current; dst.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT; dst.PlacedFootprint = footprint_;
+    list->CopyTextureRegion(&dst, 0, 0, 0, &src, nullptr);
+    transition(b[0], current, D3D12_RESOURCE_STATE_COPY_DEST, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+    transition(b[1], previous, D3D12_RESOURCE_STATE_COMMON, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+    list->ResourceBarrier(2, b);
+    record(list, previous, current, footprint_.Footprint.RowPitch, parity, compare);
+    transition(b[0], current, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE, D3D12_RESOURCE_STATE_COMMON);
+    transition(b[1], previous, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE, D3D12_RESOURCE_STATE_COMMON);
+    list->ResourceBarrier(2, b);
+}
+
+// Fourier-Mellin (VfgFourierMellin.hlsl): 2 x FFT 64x64, log-polar, FFT, cross-power, inverse FFT, peak (scale,
+// rotation); A warped, FFT, cross-power with B, inverse FFT, peak (translation). 19 small dispatches with UAV barriers.
+void CutGuard::recordFourierMellin(ID3D12GraphicsCommandList* list, ID3D12Resource* previous, ID3D12Resource* current, uint32_t rowPitch) {
+    list->SetComputeRootSignature(fmRoot_.Get());
+    list->SetPipelineState(fmPso_.Get());
+    list->SetComputeRootShaderResourceView(1, previous->GetGPUVirtualAddress());
+    list->SetComputeRootShaderResourceView(2, current->GetGPUVirtualAddress());
+    list->SetComputeRootUnorderedAccessView(3, fmScratch_->GetGPUVirtualAddress());
+    list->SetComputeRootUnorderedAccessView(4, results_->GetGPUVirtualAddress());
+    uint32_t area0 = 0, area1 = 0;
+    if (params_.areaX1 > params_.areaX0 && params_.areaY1 > params_.areaY0) {
+        area0 = uint32_t(std::clamp(params_.areaX0, 0.0f, 1.0f) * width_) | (uint32_t(std::clamp(params_.areaX1, 0.0f, 1.0f) * width_) << 16);
+        area1 = uint32_t(std::clamp(params_.areaY0, 0.0f, 1.0f) * height_) | (uint32_t(std::clamp(params_.areaY1, 0.0f, 1.0f) * height_) << 16);
+    }
+    D3D12_RESOURCE_BARRIER uav[2]{};
+    uav[0].Type = D3D12_RESOURCE_BARRIER_TYPE_UAV; uav[0].UAV.pResource = fmScratch_.Get();
+    uav[1].Type = D3D12_RESOURCE_BARRIER_TYPE_UAV; uav[1].UAV.pResource = results_.Get();
+    auto run = [&](uint32_t mode, uint32_t groups, uint32_t slabA = 0, uint32_t slabB = 0, uint32_t slabOut = 0, uint32_t inverse = 0, uint32_t which = 0) {
+        const uint32_t k[12] = {mode, width_, height_, rowPitch, format_ == DXGI_FORMAT_R10G10B10A2_UNORM ? 1u : 0u, slabA, slabB, slabOut, inverse, which, area0, area1};
+        list->SetComputeRoot32BitConstants(0, 12, k, 0);
+        list->Dispatch(groups, 1, 1);
+        list->ResourceBarrier(2, uav);
+    };
+    auto fft = [&](uint32_t slab, uint32_t count, uint32_t inverse) { run(1, 64 * count, slab, 0, 0, inverse); run(2, 64 * count, slab, 0, 0, inverse); };
+    run(0, 128);                    // both frames, windowed -> slabs 0 / 1
+    fft(0, 2, 0);
+    run(3, 128);                    // log-polar log-magnitudes -> slabs 2 / 3
+    fft(2, 2, 0);
+    run(4, 64, 2, 3, 4);            // cross-power -> slab 4
+    fft(4, 1, 1);
+    run(5, 1, 4, 0, 0, 0, 0);       // scale, rotation, peak
+    run(6, 64);                     // A warped -> slab 5
+    fft(5, 1, 0);
+    run(4, 64, 5, 1, 6);            // cross-power with B's spectrum -> slab 6
+    fft(6, 1, 1);
+    run(5, 1, 6, 0, 0, 0, 1);       // translation, peak
+}
+
+bool CutGuard::copyFlow(ID3D12GraphicsCommandList* list, FlowBuffer& b, ID3D12Resource* texture) {
+    if (!texture) return false;
+    const D3D12_RESOURCE_DESC td = texture->GetDesc();
+    D3D12_PLACED_SUBRESOURCE_FOOTPRINT fp{}; UINT rows = 0; UINT64 rowBytes = 0, total = 0;
+    device_->GetCopyableFootprints(&td, 0, 1, 0, &fp, &rows, &rowBytes, &total);
+    if (!b.buffer || b.fp.Footprint.Width != fp.Footprint.Width || b.fp.Footprint.Height != fp.Footprint.Height || b.fp.Footprint.Format != fp.Footprint.Format) {
+        b.buffer.Reset();
+        D3D12_HEAP_PROPERTIES heap{}; heap.Type = D3D12_HEAP_TYPE_DEFAULT;
+        D3D12_RESOURCE_DESC bd{}; bd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER; bd.Width = total; bd.Height = 1; bd.DepthOrArraySize = 1;
+        bd.MipLevels = 1; bd.SampleDesc.Count = 1; bd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+        if (!check(device_->CreateCommittedResource(&heap, D3D12_HEAP_FLAG_NONE, &bd, D3D12_RESOURCE_STATE_COMMON, nullptr, IID_PPV_ARGS(&b.buffer)), "cut-guard flow buffer")) return false;
+        b.fp = fp; b.state = D3D12_RESOURCE_STATE_COMMON;
+    }
+    D3D12_RESOURCE_BARRIER barrier{};
+    if (b.state != D3D12_RESOURCE_STATE_COPY_DEST) { transition(barrier, b.buffer.Get(), b.state, D3D12_RESOURCE_STATE_COPY_DEST); list->ResourceBarrier(1, &barrier); }
+    D3D12_TEXTURE_COPY_LOCATION src{}; src.pResource = texture; src.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    D3D12_TEXTURE_COPY_LOCATION dst{}; dst.pResource = b.buffer.Get(); dst.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT; dst.PlacedFootprint = b.fp;
+    list->CopyTextureRegion(&dst, 0, 0, 0, &src, nullptr);
+    transition(barrier, b.buffer.Get(), D3D12_RESOURCE_STATE_COPY_DEST, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+    list->ResourceBarrier(1, &barrier);
+    b.state = D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE;
+    return true;
+}
+
+void CutGuard::captureFlow(ID3D12GraphicsCommandList* list, ID3D12Resource* forward, ID3D12Resource* cost, ID3D12Resource* backward,
+                           uint32_t gridW, uint32_t gridH, uint32_t flowW, uint32_t flowH, bool fidelity, bool warmingUp) {
+    flowPending_ = 0;
+    if (!ready() || !list || !forward || warmingUp || !(params_.features & 128u)) return;
+    if (!copyFlow(list, flowFwd_, forward)) return;
+    uint32_t f = 1u | (fidelity ? 8u : 0u);
+    if (!fidelity && cost && copyFlow(list, flowCost_, cost)) f |= 2u;
+    if (!fidelity && backward && copyFlow(list, flowBwd_, backward)) f |= 4u;
+    flowGrid_ = gridW | (gridH << 16); flowExtent_ = flowW | (flowH << 16);
+    flowPending_ = f;
+}
+
+void CutGuard::toPredication(ID3D12GraphicsCommandList* list) {
+    if (!results_ || resultsState_ == D3D12_RESOURCE_STATE_PREDICATION) return;
+    D3D12_RESOURCE_BARRIER barrier{};
+    transition(barrier, results_.Get(), resultsState_, D3D12_RESOURCE_STATE_PREDICATION);
+    list->ResourceBarrier(1, &barrier);
+    resultsState_ = D3D12_RESOURCE_STATE_PREDICATION;
+}
+
+void CutGuard::holdOnCut(ID3D12GraphicsCommandList* list, ID3D12Resource* generated, ID3D12Resource* held, unsigned parity,
+                         ID3D12Resource* current, bool late) {
+    if (!ready() || !list || !generated || !held) return;
+    toPredication(list);
+    // up to the midpoint: A on a hard or soft cut; after it: A on a hard cut, B on a soft one
+    const uint64_t soft = kSoftOffset + (parity & 1u) * 16;
+    list->SetPredication(results_.Get(), late ? (parity & 1u) * 8 : soft, D3D12_PREDICATION_OP_EQUAL_ZERO);   // skipped unless held
+    list->CopyResource(generated, held);
+    if (late && current) {
+        list->SetPredication(results_.Get(), soft + 8, D3D12_PREDICATION_OP_EQUAL_ZERO);   // skipped unless soft
+        list->CopyResource(generated, current);
+    }
+    list->SetPredication(nullptr, 0, D3D12_PREDICATION_OP_EQUAL_ZERO);
+}
+
+void CutGuard::traceCopy(ID3D12GraphicsCommandList* list) {
+    if (!traceBuffer_) return;
+    D3D12_RESOURCE_BARRIER barrier{};
+    transition(barrier, results_.Get(), resultsState_, D3D12_RESOURCE_STATE_COPY_SOURCE);
+    list->ResourceBarrier(1, &barrier);
+    const uint32_t slot = traceNext_++ % kTraceSlots;
+    list->CopyBufferRegion(traceBuffer_.Get(), uint64_t(slot) * kTraceBytes, results_.Get(), kTraceOffset, kTraceBytes);
+    resultsState_ = D3D12_RESOURCE_STATE_COPY_SOURCE;
+    recorded_.push_back(slot);
+    if (recorded_.size() > kTraceSlots / 2) recorded_.pop_front();   // never reported as submitted: dropped
+}
+
+void CutGuard::submitted(ID3D12Fence* fence, uint64_t value) {
+    if (!traceBuffer_ || !fence) { recorded_.clear(); return; }
+    for (const uint32_t slot : recorded_) pending_.push_back({slot, value, fence});
+    recorded_.clear();
+    while (pending_.size() > kTraceSlots - 4) pending_.pop_front();
+    drainTrace(false);
+}
+
+void CutGuard::drainTrace(bool all) {
+    if (!traceBuffer_) return;
+    while (!pending_.empty()) {
+        const Pending p = pending_.front();
+        if (p.fence->GetCompletedValue() < p.value) {
+            if (!all) break;
+            HANDLE e = CreateEventW(nullptr, FALSE, FALSE, nullptr);
+            if (!e) break;
+            p.fence->SetEventOnCompletion(p.value, e);
+            WaitForSingleObject(e, 2000);
+            CloseHandle(e);
+            if (p.fence->GetCompletedValue() < p.value) break;
+        }
+        pending_.pop_front();
+        const D3D12_RANGE range{size_t(p.slot) * kTraceBytes, size_t(p.slot + 1) * kTraceBytes};
+        uint8_t* mapped = nullptr;
+        if (FAILED(traceBuffer_->Map(0, &range, reinterpret_cast<void**>(&mapped))) || !mapped) continue;
+        uint32_t u[56]{};
+        std::memcpy(u, mapped + range.Begin, sizeof(u));
+        const D3D12_RANGE none{0, 0};
+        traceBuffer_->Unmap(0, &none);
+        if (u[1] != 0 && u[21] != 0) cuts_.fetch_add(1, std::memory_order_relaxed);
+        if (!trace_) continue;
+        double gpuUs = -1.0;
+        if (tsBuffer_ && tsFrequency_) {
+            const D3D12_RANGE tr{size_t(p.slot) * 16, size_t(p.slot + 1) * 16};
+            uint8_t* tm = nullptr;
+            if (SUCCEEDED(tsBuffer_->Map(0, &tr, reinterpret_cast<void**>(&tm))) && tm) {
+                uint64_t ts[2]{}; std::memcpy(ts, tm + tr.Begin, sizeof(ts));
+                const D3D12_RANGE nothing{0, 0}; tsBuffer_->Unmap(0, &nothing);
+                if (ts[1] > ts[0]) gpuUs = double(ts[1] - ts[0]) * 1e6 / double(tsFrequency_);
+            }
+        }
+        auto f = [&](int i) { float v; std::memcpy(&v, &u[i], 4); return v; };
+        const uint32_t rules = u[20];
+        veyra::log::info("cut-guard", std::format(
+            "trace {} pair={} compare={} cut={} sad={:.4f} hist={:.4f} hist16={:.4f} histN16={:.4f} mrSad={:.4f} mrSadN={:.3f} mrSadW={:.4f} box={:.4f} "
+            "warpRatio={:.3f} base={:.4f} baseN={:.3f} baseW={:.4f} thr={:.4f} meanA={:.3f} meanB={:.3f} sigA={:.3f} sigB={:.3f} "
+            "warp=({:.3f},{:.1f},{:.3f},{:.1f}) mcSad={:.4f} mcRatio={:.3f} baseMc={:.4f} barsA={:08X} barsB={:08X} zoomRes={:.4f} zoomRes0={:.4f} zS={:.3f} zTx={:.2f} zTy={:.2f} chroma={:.4f} edge={:.4f} edgeE={:.3f} devB={:.4f} devA={:.4f} lmFrac={:.3f} lmQ25={:.3f} lmTex={} gpuUs={:.1f} score={:.2f} flowRes={:.4f} flowLap={:.3f} flowFb={:.3f} flowCost={:.3f} flowCostHi={:.3f} flowFlags={} fmRes={:.4f} fmPeak={:.3f} fmPeakT={:.3f} fmLnS={:.3f} rules={}{}{}{}{}{}{}{}{}{}{}{}{}{}{}{}{} rect={}-{}x{}-{}",
+            who_, u[0], u[1], u[21], f(2), f(3), f(4), f(5), f(6), f(7), f(8), f(24), f(25), f(9), f(10), f(11), f(26), f(12), f(13), f(14), f(15),
+            f(16), f(17), f(18), f(19), f(28), f(29), f(30), u[27], u[31], f(32), f(33), f(34), f(35), f(36), f(37), f(38), f(39), f(40), f(41), f(42), f(43), u[44], gpuUs, f(45), f(46), f(47), f(48), f(49), f(50), u[51], f(52), f(53), f(54), f(55), rules & 1 ? "F" : "-", rules & 2 ? "A" : "-", rules & 4 ? "D" : "-", rules & 8 ? "W" : "-",
+            rules & 16 ? "V" : "-", rules & 32 ? "L" : "-", rules & 64 ? "H" : "-", rules & 128 ? "k" : "-", rules & 256 ? "m" : "-", rules & 512 ? "S" : "-", rules & 1024 ? "B" : "-", rules & 2048 ? "M" : "-", rules & 4096 ? "v" : "-", rules & 8192 ? "c" : "-", rules & 16384 ? "Z" : "-", rules & 32768 ? "X" : "-", rules & 65536 ? "N" : "-",
+            u[22] & 0xFFFF, u[22] >> 16, u[23] & 0xFFFF, u[23] >> 16));
+    }
+}
+
+void CutGuard::shutdown() {
+    if (traceBuffer_) drainTrace(true);
+    pending_.clear(); recorded_.clear();
+    traceBuffer_.Reset(); tsBuffer_.Reset(); tsHeap_.Reset();
+    flowFwd_ = {}; flowCost_ = {}; flowBwd_ = {}; flowPending_ = 0;
+    fmPso_.Reset(); fmRoot_.Reset(); fmScratch_.Reset();
+    for (auto& b : inputs_) b.Reset();
+    results_.Reset(); pso_.Reset(); root_.Reset(); device_.Reset();
+    resultsState_ = D3D12_RESOURCE_STATE_COMMON;
+}
+}  // namespace veyra::pipeline
diff --git a/src/pipeline/PushMpcLinePass.cpp b/src/pipeline/PushMpcLinePass.cpp
new file mode 100644
index 0000000..e731251
--- /dev/null
+++ b/src/pipeline/PushMpcLinePass.cpp
@@ -0,0 +1,140 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// PushMPC (anime round 5): line art for NVOF frame generation (PushMpcLinePass.h, shaders/PushMpcLine.hlsl,
+// shaders/PushMpcLineDepth.hlsl).
+#include "veyra/pipeline/PushMpcLinePass.h"
+#include <algorithm>
+#include <bit>
+#include <format>
+
+namespace veyra::pipeline {
+namespace {
+constexpr D3D12_RESOURCE_STATES kRead = D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE;
+constexpr D3D12_RESOURCE_STATES kWrite = D3D12_RESOURCE_STATE_UNORDERED_ACCESS;
+constexpr UINT kTile = 16;
+}
+
+bool PushMpcLinePass::initialize(ID3D12Device* device, uint32_t width, uint32_t height, DXGI_FORMAT format, unsigned outputMode, bool withDepth) {
+    if (!device || !width || !height || format == DXGI_FORMAT_UNKNOWN) return false;
+    width_ = width; height_ = height; format_ = format; outputMode_ = outputMode;
+    copy_ = makeTexture(device, width_, height_, format_, false);
+    if (!copy_) return false;
+    std::vector<uint8_t> cs;
+    // s0 point / s1 linear clamp samplers (the warps sample between pixels)
+    if (!pass_.loadShader("PushMpcLine.dxil", cs) || !pass_.create(device, cs, (kMaxGenerated * 2 + kPairSets) * kStride, 4, 1, kConstants, 0, true)) return false;
+    if (withDepth) {
+        std::vector<uint8_t> ds;
+        depth_ = makeTexture(device, width_, height_, DXGI_FORMAT_R32_FLOAT, true);
+        if (!depth_ || !depthPass_.loadShader("PushMpcLineDepth.dxil", ds) || !depthPass_.create(device, ds, 4, 1, 1, kConstants)) {
+            depth_.Reset();
+            veyra::log::warn("nvof-line", "line depth unavailable; frame generation keeps the constant depth");
+        }
+    }
+    veyra::log::info("nvof-line", std::format("created {}x{} mode={} depth={}", width_, height_, outputMode_, depth_ ? 1 : 0));
+    return true;
+}
+
+void PushMpcLinePass::createViews(ID3D12Device* device, DescriptorStager& stager, ID3D12Resource* const real[2], ID3D12Resource* flow,
+                                  ID3D12Resource* const* generated, unsigned generatedCount) {
+    real_[0] = real[0]; real_[1] = real[1]; flow_ = flow;
+    generatedCount_ = std::min<unsigned>(generatedCount, kMaxGenerated);
+    for (unsigned slot = 0; slot < kMaxGenerated; ++slot) writable_[slot] = false;
+    depthViews_ = false;
+    if (depth_ && real_[0] && real_[1]) {
+        for (unsigned parity = 0; parity < 2; ++parity) {
+            stager.stageSrv(real_[parity], nullptr, depthPass_.heap.Get(), parity * 2);
+            makeUav(device, depth_.Get(), DXGI_FORMAT_R32_FLOAT, cpuHandleOf(depthPass_, parity * 2 + 1));
+        }
+        depthViews_ = true;
+    }
+    if (!flow_) return;
+    for (unsigned slot = 0; slot < generatedCount_; ++slot) {
+        generated_[slot] = generated[slot];
+        if (!generated_[slot]) continue;
+        const auto desc = generated_[slot]->GetDesc();
+        if (!(desc.Flags & D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS) || desc.Format != format_ || desc.Width != width_ || desc.Height != height_) continue;
+        for (unsigned parity = 0; parity < 2; ++parity) {
+            const UINT base = (slot * 2 + parity) * kStride;
+            stager.stageSrv(copy_.Get(), nullptr, pass_.heap.Get(), base);
+            stager.stageSrv(real_[1 - parity], nullptr, pass_.heap.Get(), base + 1);
+            stager.stageSrv(real_[parity], nullptr, pass_.heap.Get(), base + 2);
+            stager.stageSrv(flow_, nullptr, pass_.heap.Get(), base + 3);
+            makeUav(device, generated_[slot], format_, cpuHandleOf(pass_, base + 4));
+        }
+        writable_[slot] = true;
+    }
+}
+
+bool PushMpcLinePass::writeDepth(ID3D12GraphicsCommandList* list, StateTracker& tracker, unsigned parity) {
+    if (!list || parity > 1 || !depthReady()) return false;
+    tracker.transition(list, real_[parity], kRead);
+    tracker.transition(list, depth_.Get(), kWrite);
+    float c[kConstants]{};
+    c[0] = std::bit_cast<float>(width_); c[1] = std::bit_cast<float>(height_); c[2] = std::bit_cast<float>(uint32_t(outputMode_));
+    c[4] = kNearDepth; c[5] = kFarDepth; c[6] = kDepthTau;
+    depthPass_.bind(list, c, gpuHandleOf(depthPass_, parity * 2).ptr, gpuHandleOf(depthPass_, parity * 2 + 1).ptr);
+    list->Dispatch((width_ + kTile - 1) / kTile, (height_ + kTile - 1) / kTile, 1);
+    tracker.uavBarrier(list, depth_.Get());
+    tracker.transition(list, depth_.Get(), kRead);   // the real frame stays readable: the FG dispatch reads it next
+    ++depthWritten_;
+    return true;
+}
+
+void PushMpcLinePass::dispatchLine(ID3D12GraphicsCommandList* list, UINT base, bool hasFlow, float t) {
+    float c[kConstants]{};
+    c[0] = std::bit_cast<float>(width_); c[1] = std::bit_cast<float>(height_); c[2] = std::bit_cast<float>(uint32_t(outputMode_));
+    c[3] = std::bit_cast<float>(uint32_t(hasFlow ? 1u : 0u));
+    c[4] = std::clamp(t, 0.0f, 1.0f);
+    pass_.bind(list, c, gpuHandleOf(pass_, base).ptr, gpuHandleOf(pass_, base + 4).ptr);
+    list->Dispatch((width_ + kTile - 1) / kTile, (height_ + kTile - 1) / kTile, 1);
+}
+
+bool PushMpcLinePass::compose(ID3D12GraphicsCommandList* list, StateTracker& tracker, unsigned slot, unsigned parity, float t) {
+    if (!list || parity > 1 || !composes(slot) || !real_[0] || !real_[1]) return false;
+    auto* generated = generated_[slot];
+    tracker.transition(list, generated, D3D12_RESOURCE_STATE_COPY_SOURCE);
+    tracker.transition(list, copy_.Get(), D3D12_RESOURCE_STATE_COPY_DEST);
+    list->CopyResource(copy_.Get(), generated);
+    ID3D12Resource* const reads[] = {copy_.Get(), real_[0], real_[1], flow_};
+    for (ID3D12Resource* r : reads) tracker.transition(list, r, kRead);
+    tracker.transition(list, generated, kWrite);
+    dispatchLine(list, (slot * 2 + parity) * kStride, true, t);
+    tracker.uavBarrier(list, generated);
+    tracker.transition(list, generated, D3D12_RESOURCE_STATE_COMMON);
+    for (ID3D12Resource* r : reads) tracker.transition(list, r, D3D12_RESOURCE_STATE_COMMON);
+    ++composed_;
+    return true;
+}
+
+bool PushMpcLinePass::composePair(ID3D12Device* device, DescriptorStager& stager, ID3D12GraphicsCommandList* list,
+                                  ID3D12Resource* a, ID3D12Resource* b, ID3D12Resource* flow, ID3D12Resource* out, float t) {
+    if (!device || !list || !a || !b || !out || !copy_) return false;
+    const auto od = out->GetDesc();
+    if (!(od.Flags & D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS) || od.Format != format_ || od.Width != width_ || od.Height != height_) return false;
+    const UINT base = (kMaxGenerated * 2 + pairNext_) * kStride;
+    pairNext_ = (pairNext_ + 1) % kPairSets;
+    stager.stageSrv(copy_.Get(), nullptr, pass_.heap.Get(), base);
+    stager.stageSrv(a, nullptr, pass_.heap.Get(), base + 1);
+    stager.stageSrv(b, nullptr, pass_.heap.Get(), base + 2);
+    if (flow) stager.stageSrv(flow, nullptr, pass_.heap.Get(), base + 3);
+    else {
+        D3D12_SHADER_RESOURCE_VIEW_DESC nd{};   // a null view (the shader does not read it without motion)
+        nd.Format = DXGI_FORMAT_R16G16_FLOAT; nd.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+        nd.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING; nd.Texture2D.MipLevels = 1;
+        stager.stageSrv(nullptr, &nd, pass_.heap.Get(), base + 3);
+    }
+    makeUav(device, out, format_, cpuHandleOf(pass_, base + 4));
+    StateTracker tr;
+    ID3D12Resource* const all[] = {copy_.Get(), a, b, flow, out};
+    for (ID3D12Resource* r : all) if (r) tr.set(r, D3D12_RESOURCE_STATE_COMMON);
+    tr.transition(list, out, D3D12_RESOURCE_STATE_COPY_SOURCE);
+    tr.transition(list, copy_.Get(), D3D12_RESOURCE_STATE_COPY_DEST);
+    list->CopyResource(copy_.Get(), out);
+    for (ID3D12Resource* r : {copy_.Get(), a, b, flow}) if (r) tr.transition(list, r, kRead);
+    tr.transition(list, out, kWrite);
+    dispatchLine(list, base, flow != nullptr, t);
+    tr.uavBarrier(list, out);
+    for (ID3D12Resource* r : all) if (r) tr.transition(list, r, D3D12_RESOURCE_STATE_COMMON);
+    ++composed_;
+    return true;
+}
+}
