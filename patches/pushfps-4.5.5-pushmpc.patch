+// PushMPC (local addition, not upstream): an upscaler the graph runs on its RGBA8 RTX VSR textures without owning it
+// (PushMPC: RTX Video Super Resolution on AMD through ZLUDA, in a worker process). The same hand-off as VfxSrBackend:
+// the graph records copyIn(), submits, calls run() (GPU-side waits only), and records copyOut() in a new list.
+// run() returning false with lost() true is not a graph failure: the graph takes its plain resize for that frame and
+// every later one, so the picture never stops (the host switches the stream to another upscaler at its next rebuild).
+#include <d3d12.h>
+
+namespace veyra::pipeline {
+class ExternalSr {
+public:
+    virtual ~ExternalSr() = default;
+    // the graph's RTX VSR sizes (input = the encoded RGBA8 picture, output = the VSR result) and videoSrQuality 1..4
+    virtual bool initialize(ID3D12Device* device, unsigned inputWidth, unsigned inputHeight, unsigned outputWidth, unsigned outputHeight, unsigned quality) = 0;
+    virtual bool copyIn(ID3D12GraphicsCommandList* list, ID3D12Resource* rgba8CopySource) = 0;   // texture in COPY_SOURCE
+    virtual bool run(ID3D12CommandQueue* queue) = 0;                                              // after copyIn's list was submitted
+    virtual bool copyOut(ID3D12GraphicsCommandList* list, ID3D12Resource* rgba8CopyDest) = 0;     // texture in COPY_DEST
+    virtual bool lost() const = 0;
+    virtual const char* name() const = 0;
+    virtual void shutdown() = 0;
+};
+}
