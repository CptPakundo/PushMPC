diff --git a/shaders/PushMpcLine.hlsl b/shaders/PushMpcLine.hlsl
new file mode 100644
index 0000000..61454a1
--- /dev/null
+++ b/shaders/PushMpcLine.hlsl
@@ -0,0 +1,98 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// PushMPC (anime round 5): line-art fallback for NVOF frame generation on hard jumps (and for pushcore's FSR midpoint
+// stream). FidelityFX frame interpolation blends two warps 50/50 at the midpoint; where its vector on a thin drawn line
+// is wrong (a hard jump between two drawings, block flow) the result shows two half-contrast lines. The depth pre-pass
+// (PushMpcLineDepth.hlsl) helps FidelityFX carry line vectors; this pass catches what is left, after the frame was made
+// and BEFORE the overlays are laid back (a held subtitle is never touched).
+// Per 16x16 tile, in group-shared memory:
+//   wA = A at p + t f, wB = B at p - (1 - t) f, f = the FG motion (current -> previous, pixels) read half a step back
+//   (at p - (1 - t) f(p): where the object passing p at time t sits in B); no motion (hasFlow 0): wA = A(p), wB = B(p).
+//   line pixel: 3x3 black top-hat (closing of the dilation) of luma above kLineTau in wA or wB;
+//   candidate:  a line pixel where wA and wB disagree (luma > kLineDelta) and G lies within kBlendBand of their
+//               difference around their midpoint (the 50/50 blend FidelityFX makes): a correct single line from either
+//               frame is far from the midpoint and is left alone;
+//   guards:     fewer than kMinCandidates candidates, more blended fill pixels than blended line pixels (a dissolve or a
+//               semi-transparent layer fades its fills too), or the zero-motion blend explaining G clearly better than
+//               the warped one (a cross-fade) -> the tile is left as it is;
+//   winner:     one frame for the whole tile, never depending on t: the older frame A (the drawing holds until the new
+//               one). Never B: a tile that holds only B's half of the pair (the two halves of a hard jump often fall in
+//               different tiles) would otherwise bring B's line back at full strength next to A's;
+//   write:      candidates become A's warped colour (A's line at full strength, B's ghost replaced by A's picture).
+Texture2D<float4> genTex : register(t0);   // the generated frame as it was made (a copy)
+Texture2D<float4> realA : register(t1);    // the older real frame
+Texture2D<float4> realB : register(t2);    // the newer
+Texture2D<float2> flow : register(t3);     // the FG motion at the picture's size, pixels (unused when hasFlow is 0)
+SamplerState pointClamp : register(s0);
+SamplerState linearClamp : register(s1);
+RWTexture2D<float4> outTex : register(u0); // the generated frame
+cbuffer Constants : register(b0) {
+    uint width, height, outputMode, hasFlow;
+    float t, pad1, pad2, pad3;
+};
+static const float kLineTau = 0.05, kLineDelta = 0.04, kBlendBand = 0.25, kZeroWins = 0.8;
+static const uint kMinCandidates = 4;
+#define TILE 16
+#define SIDE 20          // TILE + 2 * 2 (closing of a dilation: radius 2)
+#define DSIDE 18         // TILE + 2 * 1
+
+groupshared float sA[SIDE * SIDE], sB[SIDE * SIDE];
+groupshared float dA[DSIDE * DSIDE], dB[DSIDE * DSIDE];
+groupshared uint nCand, nFill, errWarp, errZero;
+
+float perceptual1(float v) { return outputMode == 1 ? sqrt(max(v, 0) / 2.5) : v; }
+float lumaOf(float3 c) { return 0.2126 * perceptual1(c.r) + 0.7152 * perceptual1(c.g) + 0.0722 * perceptual1(c.b); }
+float2 uvOf(float2 p) { return (p + 0.5) / float2(width, height); }
+float2 motionAt(float2 p) { return flow.SampleLevel(pointClamp, uvOf(p), 0); }
+void warpsAt(float2 p, out float3 a, out float3 b) {
+    float2 f = 0;
+    if (hasFlow != 0) { const float2 f0 = motionAt(p); f = motionAt(p - (1.0 - t) * f0); }
+    a = realA.SampleLevel(linearClamp, uvOf(p + t * f), 0).rgb;
+    b = realB.SampleLevel(linearClamp, uvOf(p - (1.0 - t) * f), 0).rgb;
+}
+
+[numthreads(TILE, TILE, 1)]
+void main(uint3 gid : SV_GroupID, uint3 tid : SV_GroupThreadID, uint gi : SV_GroupIndex) {
+    const int2 origin = int2(gid.xy) * TILE - 2;
+    if (gi == 0) { nCand = 0; nFill = 0; errWarp = 0; errZero = 0; }
+    for (uint i = gi; i < SIDE * SIDE; i += TILE * TILE) {
+        const int2 q = clamp(origin + int2(i % SIDE, i / SIDE), int2(0, 0), int2(width - 1, height - 1));
+        float3 a, b; warpsAt(float2(q), a, b);
+        sA[i] = lumaOf(a); sB[i] = lumaOf(b);
+    }
+    GroupMemoryBarrierWithGroupSync();
+    for (uint k = gi; k < DSIDE * DSIDE; k += TILE * TILE) {
+        const uint x = k % DSIDE + 1, y = k / DSIDE + 1;
+        float ma = -1e30, mb = -1e30;
+        [unroll] for (int v = -1; v <= 1; ++v)
+            [unroll] for (int u = -1; u <= 1; ++u) { const uint j = (y + v) * SIDE + x + u; ma = max(ma, sA[j]); mb = max(mb, sB[j]); }
+        dA[k] = ma; dB[k] = mb;
+    }
+    GroupMemoryBarrierWithGroupSync();
+    const int2 p = int2(gid.xy) * TILE + int2(tid.xy);
+    const bool inside = p.x < int(width) && p.y < int(height);
+    bool cand = false;
+    if (inside) {
+        float ca = 1e30, cb = 1e30;
+        [unroll] for (int v = -1; v <= 1; ++v)
+            [unroll] for (int u = -1; u <= 1; ++u) { const uint j = (tid.y + 1 + v) * DSIDE + tid.x + 1 + u; ca = min(ca, dA[j]); cb = min(cb, dB[j]); }
+        const uint c = (tid.y + 2) * SIDE + tid.x + 2;
+        const float la = sA[c], lb = sB[c], d = abs(la - lb);
+        const bool lineA = ca - la > kLineTau, lineB = cb - lb > kLineTau;
+        if (d > kLineDelta) {
+            const float lg = lumaOf(genTex[p].rgb);
+            if (abs(lg - 0.5 * (la + lb)) <= kBlendBand * d) {
+                if (lineA || lineB) { cand = true; InterlockedAdd(nCand, 1u); }
+                else InterlockedAdd(nFill, 1u);
+            }
+            const float za = lumaOf(realA[p].rgb), zb = lumaOf(realB[p].rgb);
+            InterlockedAdd(errWarp, uint(min(abs(lg - 0.5 * (la + lb)), 1.0) * 1024.0));
+            InterlockedAdd(errZero, uint(min(abs(lg - 0.5 * (za + zb)), 1.0) * 1024.0));
+        }
+    }
+    GroupMemoryBarrierWithGroupSync();
+    if (!cand) return;
+    if (nCand < kMinCandidates || nFill > nCand) return;
+    if (hasFlow != 0 && float(errZero) < kZeroWins * float(errWarp)) return;
+    float3 a, b; warpsAt(float2(p), a, b);
+    outTex[p] = float4(a, genTex[p].a);
+}
