+// PushMPC (local addition): flow once. The grids of the last network run (at tRef) are scaled for time t in the rebuild
+// pass (PushFlowReconstruct.hlsl); Guard judges the frame as one at t (its nearer real frame).
+bool PushFlowBackend::resolveAt(ID3D12GraphicsCommandList* list, ID3D12Resource* previous, ID3D12Resource* current, ID3D12Resource* output, float t,
+                                float tRef) {
+    auto& p = *p_;
+    if (!p.haveGrids || !previous || !current || tRef <= 0.0f || tRef >= 1.0f) return false;
+    t = std::clamp(t, 0.0f, 1.0f);
+    p.flowScale0 = t / tRef; p.flowScale1 = (1.0f - t) / (1.0f - tRef); p.flowScaled = true;
+    const float netTime = p.lastTimestep;
+    p.lastTimestep = t;
+    const bool ok = resolve(list, previous, current, output);
+    p.flowScaled = false; p.flowScale0 = p.flowScale1 = 1.0f; p.lastTimestep = netTime;
+    return ok;
+}
