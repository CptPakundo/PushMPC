diff --git a/include/veyra/pipeline/PushMpcCutGuard.h b/include/veyra/pipeline/PushMpcCutGuard.h
new file mode 100644
index 0000000..19ea835
--- /dev/null
+++ b/include/veyra/pipeline/PushMpcCutGuard.h
@@ -0,0 +1,122 @@
+// SPDX-License-Identifier: GPL-3.0-only
+// PushMPC (local addition, not upstream): the scene-cut guard for every frame-generation backend.
+//
+// One GPU pair test (shaders/VfgShotChange.hlsl, one 256-thread group per real frame, no readback) decides per pair
+// whether A and B belong to different shots; the generated frames of a cut pair are then replaced, by predicated
+// copies, with the pair's first real frame A held. VfgBackend runs the test on its own encoded input buffers; the
+// other backends (DLSS-G, PushFlow, FSR FG, AMD FRC) give the guard their real output frames, which it copies into
+// two byte buffers of its own (one per parity) for the same shader.
+//
+// Rules and thresholds: see VfgShotChange.hlsl. Every threshold can be overridden for calibration runs with
+// PUSHMPC_CUT_PARAMS="name=value;..." (names as in Params), the rule set with PUSHMPC_CUT_FEATURES (bit 0 bars, 1 profile warp
+// check, 2 dark rule, 3 spike rule), and PUSHMPC_CUT_TRACE=1 logs every pair's measures ("cut-guard" log lines; a readback ring
+// that never waits on the GPU).
+#pragma once
+#include <d3d12.h>
+#include <wrl/client.h>
+#include <array>
+#include <cstdint>
+#include <deque>
+#include <atomic>
+#include <string>
+
+namespace veyra::pipeline {
+class CutGuard {
+public:
+    struct Params {
+        float adaptiveMin = 0.08f, adaptiveRatio = 5.0f, adaptiveHistogram16 = 0.15f, baselineAttack = 0.5f, baselineRelease = 0.1f;
+        float darkMean = 0.25f, darkMin = 0.7f, darkRatio = 2.5f, darkHistogram = 0.32f;
+        float spikeRatio = 3.0f, spikeMin = 0.09f, spikeHistogram = 0.27f, spikeHistogramRatio = 4.0f;
+        float warpVeto = 0.5f, warpMin = 0.08f, warpRatio = 5.0f, warpHistogram = 0.15f, holdSad = 0.004f;
+        float mcVeto = 0.5f, mcMin = 0.06f, mcRatio = 4.0f;                  // block matching
+        float barChangeBins = 2.0f, barPicture = 0.12f; uint32_t barPersist = 6;   // bar geometry, every frame
+        float barLuma = 0.10f; uint32_t barTaps = 3;   // a bar bin: at most barTaps of 32 taps above barLuma (watermarks)
+        float scoreThresholdFlow = 6.3f;               // with NVOF (round 4): non-cuts' maximum 5.48, new hits 6.73 / 9.17 (960-px flow)
+        float scoreThreshold = 6.6f;                   // scene score (round 3): between the non-cuts' maximum 5.7 and the new hits 7.6 / 9.1
+        // bars (1), dark rule (4), spike rule (8), bar-change cut (32), scene score (64); off by default after the
+        // calibration: the profile warp check (2) and block matching (16), which added no hit without a false hold
+        // (PUSHMPC_CUT_FEATURES turns them on)
+        uint32_t features = 493;   // + 128: NVOF's flow when the graph runs it (cutGuard 3); + 256: Fourier-Mellin
+        float areaX0 = 0, areaY0 = 0, areaX1 = 0, areaY1 = 0;   // fixed active area (fractions); x1 <= x0 = detect
+        bool adaptive = true;                                     // false: PushFPS's fixed rules only
+    };
+    static constexpr uint64_t kResultBytes = 1472;   // 1408..: Fourier-Mellin results
+
+    // Loads the shader and creates the result buffer (state COMMON). With ownInputs the guard also creates two byte
+    // buffers for width x height frames of `format` (R8G8B8A8_UNORM or R10G10B10A2_UNORM).
+    bool initialize(ID3D12Device* device, uint32_t width, uint32_t height, DXGI_FORMAT format, bool ownInputs, const char* who);
+    bool ready() const { return pso_ != nullptr; }
+    // Records the pair test. previous/current: byte buffers with the given row pitch, already in
+    // NON_PIXEL_SHADER_RESOURCE. Leaves the result buffer in PREDICATION. compare=false: no valid A (reset).
+    void record(ID3D12GraphicsCommandList* list, ID3D12Resource* previous, ID3D12Resource* current, uint32_t rowPitch,
+                unsigned parity, bool compare);
+    // Own inputs (the non-VFG backends): copies `texture` (the real frame of this parity, in COPY_SOURCE) into the
+    // guard's buffer of that parity and records the test against the other parity's buffer. Both buffers end in COMMON.
+    void captureAndTest(ID3D12GraphicsCommandList* list, ID3D12Resource* texture, unsigned parity, bool compare);
+    // Generated frame of a pair with parity `parity`: when the pair is a cut, a predicated copy of `held` (the pair's
+    // first real frame A, in COPY_SOURCE) over `generated` (in COPY_DEST). Nothing is copied otherwise.
+    // late: the generated frame lies after the pair's midpoint. Hard cut: A over every generated frame. Soft (nearest
+    // real): A over the frames up to the midpoint, B (`current`, in COPY_SOURCE too) over the later ones.
+    void holdOnCut(ID3D12GraphicsCommandList* list, ID3D12Resource* generated, ID3D12Resource* held, unsigned parity,
+                   ID3D12Resource* current = nullptr, bool late = false);
+    static constexpr uint64_t kSoftOffset = 1440;   // per parity: hard-or-soft (64-bit), soft-only (64-bit)
+    // Before predicated work in a list: the result buffer in PREDICATION (it already is after record()).
+    void toPredication(ID3D12GraphicsCommandList* list);
+    ID3D12Resource* results() const { return results_.Get(); }
+    // A fixed active area (fractions of the frame; x1 <= x0 = detect the bars), e.g. from the caller's own detection.
+    void setActiveArea(float x0, float y0, float x1, float y1) { params_.areaX0 = x0; params_.areaY0 = y0; params_.areaX1 = x1; params_.areaY1 = y1; }
+    const Params& params() const { return params_; }
+    // Trace (PUSHMPC_CUT_TRACE): the caller reports the fence value that covers the last recorded test.
+    void submitted(ID3D12Fence* fence, uint64_t value);
+    // Cuts held so far (from the readback ring, a few frames after the GPU decided; any thread)
+    uint64_t cuts() const { return cuts_.load(std::memory_order_relaxed); }
+    // With the trace: GPU timestamps around each test (the queue's timestamp frequency; 0 = not timed)
+    void setTimestampFrequency(uint64_t frequency) { tsFrequency_ = frequency; }
+    // The pair's optical flow (EnhanceGraph's NVOF or FidelityFX session; the textures in COPY_SOURCE), copied into the
+    // guard's buffers for its next test. NVOF: S10.5 forward vectors, R8 cost, backward vectors; FidelityFX: integer
+    // forward vectors only. Vectors point from the current frame to the previous one, in flow pixels.
+    void captureFlow(ID3D12GraphicsCommandList* list, ID3D12Resource* forward, ID3D12Resource* cost, ID3D12Resource* backward,
+                     uint32_t gridW, uint32_t gridH, uint32_t flowW, uint32_t flowH, bool fidelity, bool warmingUp);
+    void noFlow() { flowPending_ = 0; }
+    void shutdown();
+    ~CutGuard() { shutdown(); }
+
+private:
+    void loadOverrides();
+    void traceCopy(ID3D12GraphicsCommandList* list);
+    void drainTrace(bool all);
+    Microsoft::WRL::ComPtr<ID3D12Device> device_;
+    Microsoft::WRL::ComPtr<ID3D12RootSignature> root_;
+    Microsoft::WRL::ComPtr<ID3D12PipelineState> pso_;
+    Microsoft::WRL::ComPtr<ID3D12Resource> results_;
+    D3D12_RESOURCE_STATES resultsState_ = D3D12_RESOURCE_STATE_COMMON;
+    std::array<Microsoft::WRL::ComPtr<ID3D12Resource>, 2> inputs_;
+    D3D12_PLACED_SUBRESOURCE_FOOTPRINT footprint_{};
+    uint32_t width_ = 0, height_ = 0;
+    DXGI_FORMAT format_ = DXGI_FORMAT_UNKNOWN;
+    Params params_;
+    std::string who_;
+    // trace readback ring
+    bool trace_ = false;
+    static constexpr uint32_t kTraceSlots = 64, kTraceBytes = 224;
+    Microsoft::WRL::ComPtr<ID3D12Resource> traceBuffer_;
+    struct Pending { uint32_t slot; uint64_t value; ID3D12Fence* fence; };
+    std::deque<Pending> pending_;
+    std::deque<uint32_t> recorded_;    // slots recorded since the last submitted()
+    uint32_t traceNext_ = 0;
+    std::atomic<uint64_t> cuts_{0};
+    struct FlowBuffer { Microsoft::WRL::ComPtr<ID3D12Resource> buffer; D3D12_PLACED_SUBRESOURCE_FOOTPRINT fp{}; D3D12_RESOURCE_STATES state = D3D12_RESOURCE_STATE_COMMON; };
+    bool copyFlow(ID3D12GraphicsCommandList* list, FlowBuffer& b, ID3D12Resource* texture);
+    FlowBuffer flowFwd_, flowCost_, flowBwd_;
+    // Fourier-Mellin (feature 256): its own pipeline (VfgFourierMellin.hlsl) and 7 scratch slabs of 64 x 64 float2
+    Microsoft::WRL::ComPtr<ID3D12RootSignature> fmRoot_;
+    Microsoft::WRL::ComPtr<ID3D12PipelineState> fmPso_;
+    Microsoft::WRL::ComPtr<ID3D12Resource> fmScratch_;
+    void recordFourierMellin(ID3D12GraphicsCommandList* list, ID3D12Resource* previous, ID3D12Resource* current, uint32_t rowPitch);
+    uint32_t flowPending_ = 0;              // for the next test: 1 forward, 2 cost, 4 backward, 8 FidelityFX vectors
+    uint32_t flowGrid_ = 0, flowExtent_ = 0;   // gridW | gridH << 16, flowW | flowH << 16
+    uint64_t tsFrequency_ = 0;
+    Microsoft::WRL::ComPtr<ID3D12QueryHeap> tsHeap_;
+    Microsoft::WRL::ComPtr<ID3D12Resource> tsBuffer_;
+};
+}
diff --git a/include/veyra/pipeline/PushMpcLinePass.h b/include/veyra/pipeline/PushMpcLinePass.h
new file mode 100644
index 0000000..3063916
--- /dev/null
+++ b/include/veyra/pipeline/PushMpcLinePass.h
@@ -0,0 +1,62 @@
+#pragma once
+// SPDX-License-Identifier: GPL-3.0-or-later
+// PushMPC (anime round 5): line art for NVOF frame generation (FidelityFX frame interpolation fed with the graph's NVOF
+// motion), created by the graph only for NVOF FG and only while lineart::wanted(); it works while setLineCompose(true)
+// (pushcore: animation, budget). Two parts:
+//  - depth (shaders/PushMpcLineDepth.hlsl): the current real frame's drawn lines "near", the rest "far", given to
+//    FidelityFX instead of the graph's constant depth, so its nearest-depth vector dilation and scatter priority carry
+//    the line vectors (the cause);
+//  - fallback (shaders/PushMpcLine.hlsl): after the frame was made and before the overlays, per 16x16 tile a doubled
+//    line (the 50/50 blend of two disagreeing warps) becomes one line from one frame (the older one, A).
+// composePair runs the fallback on one pair outside the graph (pushcore's FSR midpoint stream; no motion there).
+#include "veyra/pipeline/GpuPassUtils.h"
+#include <string>
+
+namespace veyra::pipeline {
+namespace lineart {
+inline bool& wantedStore() { static bool wanted = false; return wanted; }
+inline void setWanted(bool on) { wantedStore() = on; }
+inline bool wanted() { return wantedStore(); }
+}
+#define PUSHMPC_NVOF_LINE_PASS 2
+
+class PushMpcLinePass {
+public:
+    static constexpr UINT kConstants = 8;
+    static constexpr UINT kMaxGenerated = 32;
+    static constexpr UINT kStride = 5;    // per view set: t0 copy, t1 older real, t2 newer real, t3 flow, u0 generated
+    static constexpr UINT kPairSets = 32; // composePair: rotating view sets (a set is rewritten 32 calls later)
+    static constexpr float kNearDepth = 0.2f, kFarDepth = 0.9f, kDepthTau = 0.05f;   // not inverted: smaller = nearer
+    // withDepth: also the depth pre-pass and its R32 texture (the graph; not pushcore's midpoint stream)
+    bool initialize(ID3D12Device* device, uint32_t width, uint32_t height, DXGI_FORMAT format, unsigned outputMode, bool withDepth);
+    void createViews(ID3D12Device* device, DescriptorStager& stager, ID3D12Resource* const real[2], ID3D12Resource* flow,
+                     ID3D12Resource* const* generated, unsigned generatedCount);
+    // the depth of real frame `parity` (the current one of the pair) into depth(); leaves it NON_PIXEL_SHADER_RESOURCE
+    bool writeDepth(ID3D12GraphicsCommandList* list, StateTracker& tracker, unsigned parity);
+    ID3D12Resource* depth() const { return depth_.Get(); }
+    bool depthReady() const { return depth_ && depthViews_; }
+    // generated[slot] lies `t` of the way from real[1 - parity] to real[parity]
+    bool compose(ID3D12GraphicsCommandList* list, StateTracker& tracker, unsigned slot, unsigned parity, float t);
+    // one pair outside the graph: a, b, out (and flow, may be null) in COMMON before and after; out has the pass's size
+    // and format and allows UAV
+    bool composePair(ID3D12Device* device, DescriptorStager& stager, ID3D12GraphicsCommandList* list,
+                     ID3D12Resource* a, ID3D12Resource* b, ID3D12Resource* flow, ID3D12Resource* out, float t);
+    bool composes(unsigned slot) const { return slot < generatedCount_ && writable_[slot] && flow_; }
+    uint64_t composed() const { return composed_; }
+    uint64_t depthWritten() const { return depthWritten_; }
+private:
+    void dispatchLine(ID3D12GraphicsCommandList* list, UINT base, bool hasFlow, float t);
+    uint32_t width_ = 0, height_ = 0;
+    unsigned outputMode_ = 0, generatedCount_ = 0;
+    DXGI_FORMAT format_ = DXGI_FORMAT_UNKNOWN;
+    ComputePass pass_, depthPass_;
+    ComPtr<ID3D12Resource> copy_, depth_;
+    ID3D12Resource* real_[2]{};
+    ID3D12Resource* flow_ = nullptr;
+    ID3D12Resource* generated_[kMaxGenerated]{};
+    bool writable_[kMaxGenerated]{};
+    bool depthViews_ = false;
+    UINT pairNext_ = 0;
+    uint64_t composed_ = 0, depthWritten_ = 0;
+};
+}
diff --git a/include/veyra/pipeline/PushOverlay.h b/include/veyra/pipeline/PushOverlay.h
index 8024511..ad5c718 100644
--- a/include/veyra/pipeline/PushOverlay.h
+++ b/include/veyra/pipeline/PushOverlay.h
@@ -49,6 +49,8 @@ struct Rule {
     int grow = 3;        // the mask is the bars and this many pixels round them
     int reach = 24;      // how far the fill looks for a pixel outside the mask
     int hole = 9;        // a pixel with an accepted bar this near on all four sides is inside a small shape, and masked
+    int signDensity = 0; // PushMPC anime signs (signZoneFor): 0 off; else the text gate (signGate below), accepted bar pixels
+    bool signStrict = true; // PushMPC anime signs: the strict text gate (strokes, a moving surround, kSignMinBlocks); false: the first gate (dense blocks only)
 };
 inline constexpr float kContrast = 0.10f;       // a bar differs this much from its flanks (the picture as encoded, 0..1)
 inline constexpr float kMoveRatio = 2.0f;       // a block moves when its change is this many times its own detail
@@ -101,6 +103,22 @@ inline Zone subtitleZoneFor(uint32_t width, uint32_t height) {
     z.y = (height - gap - h) & ~1u;
     return z;
 }
+// PushMPC anime signs: the whole picture, whole blocks on even pixels (a typeset sign, a burned-in line or a credit
+// standing over a pan can be anywhere in a drawing). The FIND, FILL and COMPOSE are the subtitle band's; the mask is
+// gated to text (signGate), because the bar rule alone also takes the outline of a held character over a pan.
+inline Zone signZoneFor(uint32_t width, uint32_t height) {
+    Zone z;
+    const uint32_t w = width / kBlock * kBlock, h = height / kBlock * kBlock;
+    if (w < 4 * kBlock || h < 4 * kBlock) return z;
+    z.w = z.size = w; z.h = h;
+    z.x = ((width - w) / 2) & ~1u; z.y = ((height - h) / 2) & ~1u;
+    return z;
+}
+// The text gate's threshold: accepted bar pixels of each direction in 3 x 3 blocks (the number is for 2160 lines;
+// replay on labelled anime clips, PushMPC round 5: the outlines of held characters over a pan on TV anime drop to
+// nothing, burned-in subtitles and credit text over a pan stay).
+inline constexpr int kSignDensity2160 = 120;
+inline int signDensityFor(uint32_t height) { return scaled(double(kSignDensity2160), height, 1, 4 * kSignDensity2160); }
 // How a frame's values become the 0..1 the thresholds are in (as Live HUD Lock): sRGB and PQ are used as
 // they are, scRGB is linear with 1 = 80 nits.
 inline float perceptual(float v, unsigned outputMode) { return outputMode == 1 ? std::sqrt(std::max(v, 0.0f) / 2.5f) : v; }
@@ -261,6 +279,91 @@ inline bool enclosed(const Plane& accepted, int x, int y, int hole) {
     return true;
 }
 // One real frame: counts, memory, and the mask (1 where frame generation is not to see the picture).
+// PushMPC anime signs: the text gate, decided per block of 16 x 16 (on the card: steps 5 and 6). A block is a SIGN
+// block when, in the 3 x 3 blocks round it (the 5 x 5 for the surround), all of these hold:
+//   dense:   at least signDensity accepted bar pixels running across AND as many running along (glyph strokes go
+//            both ways; the outline of a held character is a few long curves);
+//   strokes: the accepted pixels lie in strokes, not in specks: twice their number is at least kSignStrokeRun times
+//            the count of their edges along rows and columns (texture and broken outlines are runs of one pixel);
+//   on the screen, not in the scene: the surround (the pixels that are no accepted bar) changes between the two
+//            real frames by kSignSurroundMoves or more on average, and kSignSurroundRatio times as much as the bars
+//            themselves do. A sign stands while the picture behind it moves; scenery that moves with the camera (a
+//            dolly's slowly growing edges, outlines riding a pan) changes about as much as its surround. Over a
+//            still surround a hold buys nothing, so a wrong one there is not risked.
+// A mask pixel stays when its block or one next to it is a sign block that has kSignMinBlocks sign blocks in the
+// 3 x 3 round it, itself included (a lone patch of 48 x 48 is no line of glyphs). `accepted` holds the kinds of
+// each accepted pixel as bits (1 << kind). The numbers: replay on labelled anime, cel-shaded CG and live-action
+// clips (PushMPC round 5).
+// Rule::signStrict false keeps the first gate instead: a block is a sign block when it is dense, and one is enough.
+// The strict gate holds fewer outlines and patterns that are no text, the first one more of the text that stands over
+// a still picture; the caller picks per kind of picture.
+inline constexpr float kSignSurroundMoves = 2.5f / 255.0f;   // mean change of the surround, the picture as encoded (0..1)
+inline constexpr float kSignSurroundRatio = 3.0f;
+inline constexpr float kSignBarStill = 1.0f / 255.0f;        // the bars' own mean change counts as at least this
+inline constexpr float kSignStrokeRun = 1.1f;
+inline constexpr int kSignMinBlocks = 2;
+// Per block (step 5 on the card, the same sums in the same order): accepted pixels running across and along, the
+// edges of the accepted pixels along rows and along columns, the bars' count and summed change between the two
+// real frames, the other pixels' count and summed change. Without a frame before, nothing changes.
+struct SignStats { float across = 0, along = 0, rowEdges = 0, columnEdges = 0, bars = 0, barChange = 0, rest = 0, restChange = 0; };
+inline std::vector<SignStats> signStats(const Plane& accepted, const Plane* before, const Plane& now) {
+    const int bw = accepted.w / kBlock, bh = accepted.h / kBlock;
+    std::vector<SignStats> out(size_t(bw) * bh);
+    for (int by = 0; by < bh; ++by)
+        for (int bx = 0; bx < bw; ++bx) {
+            SignStats st;
+            for (int y = by * kBlock; y < (by + 1) * kBlock; ++y)
+                for (int x = bx * kBlock; x < (bx + 1) * kBlock; ++x) {
+                    const int k = int(accepted.at(x, y));
+                    const bool bar = k != 0;
+                    st.across += (k & 10) ? 1.0f : 0.0f;
+                    st.along += (k & 5) ? 1.0f : 0.0f;
+                    if (x > 0 && bar != (int(accepted.at(x - 1, y)) != 0)) st.rowEdges += 1.0f;
+                    if (y > 0 && bar != (int(accepted.at(x, y - 1)) != 0)) st.columnEdges += 1.0f;
+                    const float change = before ? std::fabs(now.at(x, y) - before->at(x, y)) : 0.0f;
+                    if (bar) { st.bars += 1.0f; st.barChange += change; } else { st.rest += 1.0f; st.restChange += change; }
+                }
+            out[size_t(by) * bw + bx] = st;
+        }
+    return out;
+}
+// Step 6 on the card: 1 for a sign block.
+inline std::vector<unsigned char> signBlocks(const std::vector<SignStats>& stats, int bw, int bh, int density, bool strict = true) {
+    std::vector<unsigned char> out(size_t(bw) * bh, 0);
+    for (int by = 0; by < bh; ++by)
+        for (int bx = 0; bx < bw; ++bx) {
+            float across = 0, along = 0, edges = 0, bars = 0, barChange = 0, rest = 0, restChange = 0;
+            for (int j = std::max(by - 2, 0); j <= std::min(by + 2, bh - 1); ++j)
+                for (int i = std::max(bx - 2, 0); i <= std::min(bx + 2, bw - 1); ++i) {
+                    const SignStats& st = stats[size_t(j) * bw + i];
+                    rest += st.rest; restChange += st.restChange;
+                    if (i < bx - 1 || i > bx + 1 || j < by - 1 || j > by + 1) continue;
+                    across += st.across; along += st.along; edges += st.rowEdges + st.columnEdges;
