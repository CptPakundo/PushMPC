index 0000000..3930b06
--- /dev/null
+++ b/shaders/PushMpcLineDepth.hlsl
@@ -0,0 +1,44 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// PushMPC (anime round 5): per-frame depth for NVOF frame generation on animation. PushFPS gives FidelityFX frame
+// interpolation a constant depth (0.9), which turns off its nearest-depth vector dilation (3x3), its scatter priority and
+// its disocclusion. Drawn lines of the current real frame (3x3 black top-hat of luma above kLineTau) are written "near",
+// everything else "far": FidelityFX then takes the line's own vector around a line and lets it win scatter collisions.
+// Depth is not inverted for this context (smaller = nearer). One read per pixel, group-shared 16x16 tiles.
+Texture2D<float4> colour : register(t0);   // the current real frame
+RWTexture2D<float> depthOut : register(u0);
+cbuffer Constants : register(b0) {
+    uint width, height, outputMode, pad0;
+    float nearDepth, farDepth, tau, pad1;
+};
+#define TILE 16
+#define SIDE 20
+#define DSIDE 18
+groupshared float s[SIDE * SIDE];
+groupshared float dl[DSIDE * DSIDE];
+
+float perceptual1(float v) { return outputMode == 1 ? sqrt(max(v, 0) / 2.5) : v; }
+float lumaOf(float3 c) { return 0.2126 * perceptual1(c.r) + 0.7152 * perceptual1(c.g) + 0.0722 * perceptual1(c.b); }
+
+[numthreads(TILE, TILE, 1)]
+void main(uint3 gid : SV_GroupID, uint3 tid : SV_GroupThreadID, uint gi : SV_GroupIndex) {
+    const int2 origin = int2(gid.xy) * TILE - 2;
+    for (uint i = gi; i < SIDE * SIDE; i += TILE * TILE) {
+        const int2 q = clamp(origin + int2(i % SIDE, i / SIDE), int2(0, 0), int2(width - 1, height - 1));
+        s[i] = lumaOf(colour[q].rgb);
+    }
+    GroupMemoryBarrierWithGroupSync();
+    for (uint k = gi; k < DSIDE * DSIDE; k += TILE * TILE) {
+        const uint x = k % DSIDE + 1, y = k / DSIDE + 1;
+        float m = -1e30;
+        [unroll] for (int v = -1; v <= 1; ++v)
+            [unroll] for (int u = -1; u <= 1; ++u) m = max(m, s[(y + v) * SIDE + x + u]);
+        dl[k] = m;
+    }
+    GroupMemoryBarrierWithGroupSync();
+    const int2 p = int2(gid.xy) * TILE + int2(tid.xy);
+    if (p.x >= int(width) || p.y >= int(height)) return;
+    float c = 1e30;
+    [unroll] for (int v = -1; v <= 1; ++v)
+        [unroll] for (int u = -1; u <= 1; ++u) c = min(c, dl[(tid.y + 1 + v) * DSIDE + tid.x + 1 + u]);
+    depthOut[p] = c - s[(tid.y + 2) * SIDE + tid.x + 2] > tau ? nearDepth : farDepth;
+}
