// pushcore.dll version resource (configured by CMake). The MPC-VR fork reads "PushFPSVersion" with
// GetFileVersionInfo before loading the DLL, to refuse an installed PushFPS of another version.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PUSHMPC_VER_COMMA@
 PRODUCTVERSION @PUSHMPC_VER_COMMA@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "PushMPC (local build)"
            VALUE "FileDescription", "PushMPC core: PushFPS enhancement graph for MPC Video Renderer"
            VALUE "FileVersion", "@PUSHMPC_PUSHFPS_VERSION@"
            VALUE "InternalName", "pushcore"
            VALUE "OriginalFilename", "pushcore.dll"
            VALUE "ProductName", "PushMPC"
            VALUE "ProductVersion", "@PUSHMPC_PUSHFPS_VERSION@"
            VALUE "PushFPSVersion", "@PUSHMPC_PUSHFPS_VERSION@"
            VALUE "PushFPSCommit", "@PUSHMPC_PUSHFPS_COMMIT@"
            VALUE "PushCoreAbi", "@PUSHMPC_ABI@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
