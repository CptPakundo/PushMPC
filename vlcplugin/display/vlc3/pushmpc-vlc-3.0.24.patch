+/* PushMPC: the NIS scaler, for any GPU (the video processor's super resolution is NVIDIA / Intel / AMD only); its output
+ * RGB10A2 for sources of more than 8 bits (P010, HDR10 / HLG: RGBA8 would cut them to 8 bits), else RGBA8 */
+d3d11_scaler *D3D11_UpscalerCreateNis(vlc_object_t *vd, d3d11_device_t *d3d_dev, float sharpness, const d3d_format_t **out_fmt)
+{
+    const d3d_format_t *fmt = nullptr, *fmt8 = nullptr, *fmt10 = nullptr;
+    for (const d3d_format_t *f = GetRenderFormatList(); f->name != nullptr; ++f)
+    {
+        if (f->formatTexture == DXGI_FORMAT_R8G8B8A8_UNORM && f->fourcc == VLC_CODEC_RGBA && fmt8 == nullptr) fmt8 = f;
+        if (f->formatTexture == DXGI_FORMAT_R10G10B10A2_UNORM && f->fourcc == VLC_CODEC_RGBA10 && fmt10 == nullptr) fmt10 = f;
+    }
+    const bool deep = *out_fmt != nullptr && (*out_fmt)->bitsPerChannel > 8;
+    if (deep && fmt10 != nullptr && PM_NisFormatOk(d3d_dev, DXGI_FORMAT_R10G10B10A2_UNORM))
+        fmt = fmt10;
+    else
+    {
+        if (deep)
+            msg_Warn(vd, "PushMPC NIS: this GPU cannot write RGB10A2 from a compute shader: 8 bits per channel");
+        fmt = fmt8;
+    }
+    if (fmt == nullptr)
+    {
+        msg_Warn(vd, "PushMPC NIS: no RGBA output format");
+        return nullptr;
+    }
+    d3d11_scaler *scaleProc = new (std::nothrow) d3d11_scaler;
+    if (unlikely(scaleProc == nullptr))
+        return nullptr;
+    scaleProc->nis = PM_NisCreateFormat(vd, d3d_dev, fmt->formatTexture);
+    if (scaleProc->nis == nullptr)
+    {
+        delete scaleProc;
+        return nullptr;
+    }
+    scaleProc->sharpness = sharpness;
+    scaleProc->nis_dev = d3d_dev;
+    scaleProc->d3d_fmt = fmt;
+    *out_fmt = fmt;
+    return scaleProc;
+}
+
+bool D3D11_UpscalerIsNis(const d3d11_scaler *scaleProc)
+{
+    return scaleProc->nis != nullptr;
+}
+
+/* PushMPC: pushcore's upscaler drawn into this scaler's window-size output texture (the same quad contract) for the
+ * pictures it has: the NIS scaler's or the video processor's (driver Super Resolution); not on AMD's AMF scaler (its
+ * output texture changes per picture) */
+bool D3D11_UpscalerAddPushcore(vlc_object_t *vd, d3d11_scaler *scaleProc, d3d11_device_t *d3d_dev, const video_format_t *source,
+                               vlc_fourcc_t chroma, unsigned display_width, unsigned display_height, HWND wnd, int mode)
+{
+    if (scaleProc->pcsr)
+        return true;
+#ifdef HAVE_AMF_SCALER
+    if (scaleProc->amf_scaler)
+    {
+        msg_Info(vd, "PushMPC anime upscaler not used (AMD's scaler runs)");
+        return false;
+    }
+#endif
+    scaleProc->pcsr = PM_PcsrCreate(vd, d3d_dev, source, chroma, display_width, display_height, wnd, mode, scaleProc->nis == nullptr);
+    scaleProc->pcsr_dev = scaleProc->pcsr ? d3d_dev : nullptr;
+    return scaleProc->pcsr != nullptr;
+}
+
+/* PushMPC: outside the context lock (pushcore's bridge takes it itself); when pushcore does not keep up, the scaler
+ * stays for the stream */
+void D3D11_UpscalerFeed(vlc_object_t *vd, d3d11_scaler *scaleProc, picture_sys_t *p_sys, mtime_t date)
+{
+    if (scaleProc->pcsr && PM_PcsrFeed(vd, scaleProc->pcsr, scaleProc->pcsr_dev, p_sys, date) != VLC_SUCCESS)
+    {
+        PM_PcsrDestroy(scaleProc->pcsr);
+        scaleProc->pcsr = nullptr;
+    }
+}
