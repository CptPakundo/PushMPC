+            p_sys->formatTexture == DXGI_FORMAT_P016)
+            count = 2;
+        else
+            while (count < 3 && p_sys->resourceView[count]) count++;
+        if (p_sys->formatTexture != DXGI_FORMAT_NV12 && p_sys->formatTexture != DXGI_FORMAT_P010 &&
+            p_sys->formatTexture != DXGI_FORMAT_P016 && count != 3 && count != 1)
+            return VLC_EGENERIC;
+        return PM_NisProcess(vd, scaleProc->nis, scaleProc->nis_dev, p_sys->resourceView, count,
+                             &scaleProc->srcfmt, &scaleProc->place, scaleProc->sharpness);
+    }
