#version 450
#extension GL_GOOGLE_include_directive : require
// SPDX-License-Identifier: GPL-3.0-or-later
// PushMPC portable GPU engine: NVIDIA Image Scaling (NIS) 1.0.3 on the luma plane. The unchanged MIT-licensed
// NIS_Scaler.h (third_party/nis) in its GLSL form, with the bindings PushFPS's portable/app/shaders/nis.comp.in gives
// it. The input view repeats the luma in R, G and B (component swizzle), so NIS's own luma is the video's luma; the
// output is one 16-bit channel. NIS works on the picture as encoded (NIS_HDR_MODE 0), which is what the plane holds
// (gamma or PQ coded): settings as PushFPS's pass, 32 x 24 pixel blocks, 256 threads.
#define NIS_GLSL 1
#define NIS_SCALER 1
#define NIS_HDR_MODE 0
#define NIS_BLOCK_WIDTH 32
#define NIS_BLOCK_HEIGHT 24
#define NIS_THREAD_GROUP_SIZE 256

// NISConfig (NIS_Config.h) without its padding: 28 values of 4 bytes, the same order.
layout(std140, binding = 0) uniform const_buffer {
    float kDetectRatio;
    float kDetectThres;
    float kMinContrastRatio;
    float kRatioNorm;

    float kContrastBoost;
    float kEps;
    float kSharpStartY;
    float kSharpScaleY;

    float kSharpStrengthMin;
    float kSharpStrengthScale;
    float kSharpLimitMin;
    float kSharpLimitScale;

    float kScaleX;
    float kScaleY;

    float kDstNormX;
    float kDstNormY;
    float kSrcNormX;
    float kSrcNormY;

    uint kInputViewportOriginX;
    uint kInputViewportOriginY;
    uint kInputViewportWidth;
    uint kInputViewportHeight;

    uint kOutputViewportOriginX;
    uint kOutputViewportOriginY;
    uint kOutputViewportWidth;
    uint kOutputViewportHeight;

    float reserved0;
    float reserved1;
};

layout(binding = 1) uniform sampler samplerLinearClamp;
layout(binding = 2) uniform texture2D in_texture;
layout(binding = 3) uniform texture2D coef_scaler;
layout(binding = 4) uniform texture2D coef_usm;
layout(binding = 5, r16) uniform writeonly image2D out_texture;

layout(local_size_x = NIS_THREAD_GROUP_SIZE, local_size_y = 1, local_size_z = 1) in;

#include "NIS_Scaler.h"

void main()
{
    NVScaler(gl_WorkGroupID.xy, gl_LocalInvocationID.x);
}
