# cmake -DIN=<binary> -DOUT=<file.cpp> [-DNAME=<symbol>] -P bin2cpp.cmake: a binary (a CUDA fatbin) as a C++ array,
# 16-byte aligned as cuModuleLoadData wants its image; <symbol> and <symbol>_size.
if(NOT NAME)
  set(NAME nvl_kernels_fatbin)
endif()
file(READ "${IN}" hex HEX)
string(LENGTH "${hex}" n)
math(EXPR bytes "${n} / 2")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," body "${hex}")
string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){32})" "\\1\n" body "${body}")
file(WRITE "${OUT}" "// generated by bin2cpp.cmake\nextern \"C\" {\nalignas(16) extern const unsigned char ${NAME}[] = {\n${body}\n};\nextern const unsigned long ${NAME}_size = ${bytes}ul;\n}\n")
